{
    "name": "@seedcord/plugin-utils",
    "version": "0.0.1-next.0",
    "private": true,
    "description": "Code that the first-party plugins share and bundle",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/plugin-utils"
    },
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./testing": {
            "import": {
                "types": "./dist/testing.d.mts",
                "default": "./dist/testing.mjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.ts' --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.ts' --fix --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev"
    },
    "dependencies": {
        "@seedcord/errors": "workspace:^",
        "@seedcord/logger": "workspace:^",
        "@seedcord/types": "workspace:^",
        "reflect-metadata": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/core": "workspace:^",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/prose": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vite-config": "workspace:^",
        "type-fest": "catalog:deps",
        "vite-plus": "catalog:deps"
    },
    "peerDependencies": {
        "@seedcord/core": "workspace:^",
        "typescript": "catalog:peer"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
