{
    // the parser must accept jsonc, tsc does
    "compilerOptions": {
        "paths": {
            "#src/*": ["./src/*"],
            "#src/nested/*": ["./nested/*"],
            "#lib/*": ["./src/lib-*"],
            "#flat": ["./src/flat.ts"],
            "#flat/sub": ["./src/sub.ts"]
        }
    }
}
