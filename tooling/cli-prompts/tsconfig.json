{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "jsx": "react",
        "paths": {
            "#src/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "playground/**/*.ts",
        "eslint.config.ts",
        "tsdown.config.ts",
        "vitest.config.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
