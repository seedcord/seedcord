{
    "name": "@seedcord/cli-templates",
    "version": "0.0.0",
    "private": true,
    "description": "Reads and renders the Handlebars templates seedcord make writes files from",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/cli-templates"
    },
    "type": "module",
    "types": "./dist/index.d.mts",
    "imports": {
        "#tests/*": "./tests/*.ts",
        "#src/*": "./src/*.ts"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./helper-names": {
            "import": {
                "types": "./dist/helperNames.d.mts",
                "default": "./dist/helperNames.mjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev"
    },
    "dependencies": {
        "@seedcord/errors": "workspace:^",
        "@seedcord/utils": "workspace:^",
        "es-toolkit": "catalog:deps",
        "handlebars": "catalog:deps",
        "type-fest": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/core": "workspace:^",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/types": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
