{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": ".",
        "paths": {
            "#src/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "tsdown.config.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "dist", "generated"]
}
