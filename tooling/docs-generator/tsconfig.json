{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": ".",
        "paths": {
            "#src/*": ["./src/*"],
            "@seedcord/fixture-base": ["./tests/mock-base/index.ts"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "eslint.config.ts", "tsdown.config.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "dist", "generated"]
}
