{
    "name": "@seedcord/docs-generator",
    "version": "0.2.4",
    "private": true,
    "description": "Internal tooling to generate seedcord API model JSON files",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/docs-generator"
    },
    "files": [
        "dist",
        "src",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "typesVersions": {
        "*": {
            "*": [
                "./dist/index.d.ts",
                "./src/index.ts"
            ]
        }
    },
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./manifest-fields": {
            "import": {
                "types": "./dist/manifest-fields.d.mts",
                "default": "./dist/manifest-fields.mjs"
            }
        },
        "./runtime-build": {
            "import": {
                "types": "./dist/RuntimeBuild.d.mts",
                "default": "./dist/RuntimeBuild.mjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@microsoft/api-extractor": "7.59.3",
        "typescript": "catalog:peer",
        "yaml": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "vitest": "catalog:test"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
