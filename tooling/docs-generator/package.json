{
    "name": "@seedcord/docs-generator",
    "version": "0.2.4",
    "engines": {
        "node": ">=24.11"
    },
    "private": true,
    "description": "Internal tooling to generate seedcord API model JSON files",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/docs-generator"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./manifest-fields": {
            "import": {
                "types": "./dist/manifest-fields.d.mts",
                "default": "./dist/manifest-fields.mjs"
            }
        }
    },
    "typesVersions": {
        "*": {
            "*": [
                "./dist/index.d.ts",
                "./src/index.ts"
            ]
        }
    },
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "prettier --write '**/*.{ts,tsx,json,md}' --cache --no-error-on-unmatched-pattern",
        "fmt:check": "prettier --check '**/*.{ts,tsx,json,md}' --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "files": [
        "dist",
        "src",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@microsoft/api-extractor": "7.58.9",
        "typescript": "catalog:peer",
        "yaml": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^"
    }
}
