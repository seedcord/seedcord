{
    "name": "@seedcord/ui",
    "version": "0.2.0",
    "engines": {
        "node": ">=24.11"
    },
    "private": true,
    "type": "module",
    "description": "Internal UI primitives for seedcord apps (docs, guide, home)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/ui"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./palette": {
            "import": {
                "types": "./dist/palette.d.mts",
                "default": "./dist/palette.mjs"
            }
        },
        "./og": {
            "import": {
                "types": "./dist/og.d.mts",
                "default": "./dist/og.mjs"
            }
        },
        "./MaterwelonGlyph": {
            "import": {
                "types": "./dist/MaterwelonGlyph.d.mts",
                "default": "./dist/MaterwelonGlyph.mjs"
            }
        },
        "./MaterwelonFavicon": {
            "import": {
                "types": "./dist/MaterwelonFavicon.d.mts",
                "default": "./dist/MaterwelonFavicon.mjs"
            }
        },
        "./Materwelon": {
            "import": {
                "types": "./dist/Materwelon.d.mts",
                "default": "./dist/Materwelon.mjs"
            }
        },
        "./styles/globals.css": "./src/styles/globals.css",
        "./styles/tokens.css": "./src/styles/tokens.css"
    },
    "files": [
        "dist",
        "src/styles",
        "package.json",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md,css}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md,css}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "react": "catalog:react",
        "react-dom": "catalog:react"
    },
    "dependencies": {
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tooltip": "^1.2.16",
        "clsx": "^2.1.1",
        "lucide-react": "catalog:deps",
        "motion": "catalog:deps",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@testing-library/dom": "catalog:test",
        "@testing-library/jest-dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "eslint-plugin-better-tailwindcss": "catalog:eslint",
        "eslint-plugin-tailwind-canonical-classes": "catalog:eslint",
        "jsdom": "catalog:test",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "tailwindcss": "catalog:deps"
    }
}
