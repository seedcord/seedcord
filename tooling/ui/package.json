{
    "name": "@seedcord/ui",
    "version": "0.2.1",
    "engines": {
        "node": ">=24.11",
        "bun": ">=1.4.2"
    },
    "private": true,
    "type": "module",
    "description": "Internal UI primitives for seedcord apps (docs, guide, home)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/ui"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./*": {
            "types": "./dist/*.d.mts",
            "default": "./dist/*.mjs"
        },
        "./styles/globals.css": "./src/styles/globals.css",
        "./styles/tokens.css": "./src/styles/tokens.css"
    },
    "files": [
        "dist",
        "src/styles",
        "package.json",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "prettier --write '**/*.{ts,tsx,json,md,css}' --cache --no-error-on-unmatched-pattern",
        "fmt:check": "prettier --check '**/*.{ts,tsx,json,md,css}' --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "next": "catalog:deps",
        "react": "catalog:react",
        "react-dom": "catalog:react"
    },
    "peerDependenciesMeta": {
        "next": {
            "optional": true
        }
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-switch": "^1.3.7",
        "@radix-ui/react-tooltip": "^1.2.16",
        "@shikijs/langs": "^4.5.0",
        "clsx": "^2.1.1",
        "discord-component-embed": "workspace:^",
        "lucide-react": "catalog:deps",
        "motion": "catalog:deps",
        "next-themes": "^0.4.6",
        "shiki": "catalog:deps",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@testing-library/dom": "catalog:test",
        "@testing-library/jest-dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@testing-library/user-event": "catalog:test",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "eslint-plugin-better-tailwindcss": "catalog:eslint",
        "eslint-plugin-tailwind-canonical-classes": "catalog:eslint",
        "jsdom": "catalog:test",
        "next": "catalog:deps",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "tailwindcss": "catalog:deps"
    }
}
