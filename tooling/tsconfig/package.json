{
    "name": "@seedcord/tsconfig",
    "version": "3.0.0",
    "description": "Shared TypeScript config for seedcord projects",
    "keywords": [
        "seedcord",
        "tsconfig",
        "typescript"
    ],
    "homepage": "https://seedcord.org",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/tsconfig"
    },
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "files": [
        "base.json",
        "node.json",
        "LICENSE",
        "README.md"
    ],
    "type": "module",
    "main": "./base.json",
    "exports": {
        ".": {
            "default": "./base.json"
        },
        "./base": {
            "default": "./base.json"
        },
        "./node": {
            "default": "./node.json"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "echo 'Are you seriously trying to build .json files?'",
        "clean": "echo 'What build artifacts?'"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
