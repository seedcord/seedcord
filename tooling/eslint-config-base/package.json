{
    "name": "@seedcord/eslint-config-base",
    "version": "0.0.1",
    "private": true,
    "description": "Internal ESLint config content, bundled into @seedcord/eslint-config",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/eslint-config-base"
    },
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./prettier": {
            "import": {
                "types": "./dist/prettier.d.mts",
                "default": "./dist/prettier.mjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.ts' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.ts' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit"
    },
    "dependencies": {
        "@types/eslint-plugin-security": "catalog:eslint",
        "@typescript-eslint/parser": "catalog:eslint",
        "es-toolkit": "catalog:deps",
        "eslint-config-prettier": "catalog:eslint",
        "eslint-import-resolver-typescript": "catalog:eslint",
        "eslint-plugin-import-x": "catalog:eslint",
        "eslint-plugin-security": "catalog:eslint",
        "eslint-plugin-tsdoc": "catalog:eslint",
        "eslint-plugin-unicorn": "catalog:eslint",
        "prettier": "catalog:deps",
        "typescript-eslint": "catalog:eslint"
    },
    "devDependencies": {
        "@seedcord/tsconfig": "workspace:^",
        "eslint": "catalog:eslint"
    },
    "peerDependencies": {
        "eslint": "^9.22.0 || ^10.4.0",
        "eslint-plugin-better-tailwindcss": "catalog:eslint",
        "eslint-plugin-mdx": "catalog:eslint",
        "eslint-plugin-tailwind-canonical-classes": "catalog:eslint",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "tailwindcss": "catalog:deps",
        "typescript": "catalog:peer"
    },
    "peerDependenciesMeta": {
        "prettier-plugin-tailwindcss": {
            "optional": true
        },
        "tailwindcss": {
            "optional": true
        },
        "eslint-plugin-mdx": {
            "optional": true
        },
        "eslint-plugin-better-tailwindcss": {
            "optional": true
        },
        "eslint-plugin-tailwind-canonical-classes": {
            "optional": true
        }
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
