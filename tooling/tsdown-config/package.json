{
    "name": "@seedcord/tsdown-config",
    "version": "2.0.1",
    "private": true,
    "description": "Internal tsdown preset for seedcord packages",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/tsdown-config"
    },
    "files": [
        "dist",
        "src"
    ],
    "type": "module",
    "main": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "lint": "eslint '**/*.ts' --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.ts' --fix --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit"
    },
    "devDependencies": {
        "@seedcord/eslint-config-base": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@types/node": "catalog:deps",
        "typescript": "catalog:peer",
        "vite-plus": "catalog:deps"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
