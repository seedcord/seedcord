{
    "name": "@seedcord/docs-engine",
    "version": "0.3.2",
    "private": true,
    "description": "Documentation parser, renderer, and explorer for Seedcord",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/docs-engine"
    },
    "files": [
        "dist",
        "src",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "imports": {
        "#tests/*": "./tests/*",
        "#src/*": "./src/*",
        "#model/*": "./src/model/*",
        "#builders/*": "./src/builders/*",
        "#routing/*": "./src/routing/*",
        "#services/*": "./src/services/*",
        "#transformers/*": "./src/transformers/*",
        "#packages/*": "./src/packages/*",
        "#remote/*": "./src/remote/*"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./client": {
            "import": {
                "types": "./dist/client.d.mts",
                "default": "./dist/client.mjs"
            }
        },
        "./workspace": {
            "import": {
                "types": "./dist/workspace.d.mts",
                "default": "./dist/workspace.mjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "vp fmt --write '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "fmt:check": "vp fmt --check '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@leeoniya/ufuzzy": "catalog:deps",
        "@microsoft/api-extractor-model": "7.33.14",
        "@microsoft/tsdoc": "^0.17.1",
        "@seedcord/docs-generator": "workspace:^",
        "prettier": "catalog:deps",
        "semver": "^7.8.5"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@types/semver": "^7.8.0",
        "vitest": "catalog:test"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": ">=24.11"
    }
}
