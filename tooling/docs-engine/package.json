{
    "name": "@seedcord/docs-engine",
    "version": "0.3.2",
    "private": true,
    "description": "Documentation parser, renderer, and explorer for Seedcord",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/docs-engine"
    },
    "files": [
        "dist",
        "src",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "imports": {
        "#tests/*": "./tests/*.ts",
        "#src/*": "./src/*.ts",
        "#model/*": "./src/model/*.ts",
        "#builders/*": "./src/builders/*.ts",
        "#routing/*": "./src/routing/*.ts",
        "#transformers/*": "./src/transformers/*.ts",
        "#packages/*": "./src/packages/*.ts",
        "#remote/*": "./src/remote/*.ts"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./client": {
            "import": {
                "types": "./dist/client.d.mts",
                "default": "./dist/client.mjs"
            }
        },
        "./workspace": {
            "import": {
                "types": "./dist/workspace.d.mts",
                "default": "./dist/workspace.mjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@microsoft/api-extractor-model": "7.33.14",
        "@microsoft/tsdoc": "^0.17.1",
        "@seedcord/docs-generator": "workspace:^",
        "@seedcord/docs-search": "workspace:^",
        "prettier": "catalog:deps",
        "verkit": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "vitest": "catalog:test"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
