{
    "name": "@seedcord/docs-engine",
    "version": "0.3.2",
    "engines": {
        "node": "^24.22.1 || >=26.12.1",
        "bun": ">=1.4.2"
    },
    "private": true,
    "description": "Documentation parser, renderer, and explorer for Seedcord",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/docs-engine"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./client": {
            "import": {
                "types": "./dist/client.d.mts",
                "default": "./dist/client.mjs"
            }
        },
        "./workspace": {
            "import": {
                "types": "./dist/workspace.d.mts",
                "default": "./dist/workspace.mjs"
            }
        }
    },
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "fmt": "prettier --write '**/*.{ts,tsx,json,md}' --cache --no-error-on-unmatched-pattern",
        "fmt:check": "prettier --check '**/*.{ts,tsx,json,md}' --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "files": [
        "dist",
        "src",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@microsoft/api-extractor-model": "7.33.14",
        "@microsoft/tsdoc": "^0.17.1",
        "@seedcord/docs-generator": "workspace:^",
        "@seedcord/docs-search": "workspace:^",
        "prettier": "catalog:deps",
        "verkit": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^"
    }
}
