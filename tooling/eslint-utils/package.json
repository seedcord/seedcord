{
    "name": "@seedcord/eslint-utils",
    "version": "0.0.1",
    "private": true,
    "description": "Internal shared utilities for the seedcord eslint plugins",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/eslint-utils"
    },
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.ts' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.ts' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit"
    },
    "dependencies": {
        "@typescript-eslint/utils": "catalog:eslint"
    },
    "devDependencies": {
        "@seedcord/eslint-config-base": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "eslint": "catalog:eslint"
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
