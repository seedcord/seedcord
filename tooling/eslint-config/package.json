{
    "name": "@seedcord/eslint-config",
    "type": "module",
    "version": "2.0.0-next.0",
    "engines": {
        "node": ">=24.11"
    },
    "description": "Shared ESLint config for seedcord projects",
    "keywords": [
        "eslint",
        "eslintconfig",
        "eslint-config",
        "seedcord",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/eslint-config"
    },
    "homepage": "https://seedcord.org",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./prettier": {
            "import": {
                "types": "./dist/prettier.d.mts",
                "default": "./dist/prettier.mjs"
            }
        }
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint '*.{mjs,ts}' 'src/**/*.ts' 'tests/**/*.ts' --cache",
        "lint:fix": "eslint '*.{mjs,ts}' 'src/**/*.ts' 'tests/**/*.ts' --fix --cache",
        "fmt": "prettier --write '*.{mjs,ts,json,md}' 'src/**/*.ts' 'tests/**/*.ts' --cache",
        "fmt:check": "prettier --check '*.{mjs,ts,json,md}' 'src/**/*.ts' 'tests/**/*.ts' --cache",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "eslint": "^9.22.0 || ^10.4.0",
        "eslint-plugin-better-tailwindcss": "catalog:eslint",
        "eslint-plugin-tailwind-canonical-classes": "catalog:eslint",
        "eslint-plugin-mdx": "catalog:eslint",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "tailwindcss": "catalog:deps",
        "typescript": "catalog:peer"
    },
    "peerDependenciesMeta": {
        "prettier-plugin-tailwindcss": {
            "optional": true
        },
        "tailwindcss": {
            "optional": true
        },
        "eslint-plugin-mdx": {
            "optional": true
        },
        "eslint-plugin-better-tailwindcss": {
            "optional": true
        },
        "eslint-plugin-tailwind-canonical-classes": {
            "optional": true
        }
    },
    "dependencies": {
        "@seedcord/eslint-plugin": "workspace:^",
        "@types/eslint-plugin-security": "catalog:eslint",
        "@typescript-eslint/parser": "catalog:eslint",
        "eslint-config-prettier": "catalog:eslint",
        "eslint-import-resolver-typescript": "catalog:eslint",
        "eslint-plugin-discordjs": "workspace:^",
        "eslint-plugin-import-x": "catalog:eslint",
        "eslint-plugin-security": "catalog:eslint",
        "eslint-plugin-tsdoc": "catalog:eslint",
        "eslint-plugin-unicorn": "catalog:eslint",
        "lodash.merge": "catalog:deps",
        "prettier": "catalog:deps",
        "typescript-eslint": "catalog:eslint"
    },
    "devDependencies": {
        "@seedcord/eslint-config-base": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@typescript-eslint/utils": "catalog:eslint",
        "eslint": "catalog:eslint"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
