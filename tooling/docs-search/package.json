{
    "name": "@seedcord/docs-search",
    "version": "0.0.0",
    "private": true,
    "description": "Shared guide and reference search",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "tooling/docs-search"
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "imports": {
        "#tests/*": "./tests/*.ts",
        "#src/*": "./src/*.ts"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        }
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@leeoniya/ufuzzy": "catalog:deps",
        "fumadocs-core": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/ui": "workspace:^",
        "@seedcord/vitest-config": "workspace:^"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
