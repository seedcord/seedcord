{
    "name": "@seedcord/mock-gateway",
    "version": "0.2.34",
    "private": true,
    "description": "Gateway-transport mock bot for demonstration and testing",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "mocks/gateway"
    },
    "type": "module",
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "start": "vp run build && node --enable-source-maps dist/index.mjs",
        "codegen": "seedcord codegen",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "vp fmt --write '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "fmt:check": "vp fmt --check '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "tc:watch": "tsc --noEmit --watch"
    },
    "dependencies": {
        "@discordjs/builders": "catalog:deps",
        "@seedcord/gateway": "workspace:^",
        "@seedcord/plugin-mongoose": "workspace:^",
        "discord.js": "catalog:peer",
        "envapt": "catalog:peer",
        "mongoose": "catalog:peer"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "seedcord": "workspace:^"
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "engines": {
        "node": ">=24.11"
    }
}
