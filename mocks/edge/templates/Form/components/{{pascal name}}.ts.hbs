{{> header part="the modal" }}
import { BuilderComponent, CustomId } from '{{ transport }}';
import { TextInputStyle } from 'discord-api-types/v10';

export const {{ pascal name }}Id = new CustomId('{{ kebab name }}');

export class {{ pascal name }}Modal extends BuilderComponent<'modal'> {
    constructor() {
        super('modal');

        this.instance
            .setCustomId({{ pascal name }}Id.encode({}))
            .setTitle({{ quote title }}){{#each fields as |field index|}}
            // field {{ index }} of {{ @root.title }}
            .addLabelComponents((label) =>
                label.setLabel({{ quote field.label }}).setTextInputComponent((input) =>
                    input
                        .setCustomId('{{ kebab field.label }}')
                        .setStyle(TextInputStyle.{{#if field.long}}Paragraph{{else}}Short{{/if}})
                        .setRequired({{#if field.required}}true{{else}}false{{/if}})
                )
            ){{/each}};
    }
}
