{
    "name": "@seedcord/mock-edge",
    "version": "0.0.0",
    "private": true,
    "description": "Edge mock bot on Cloudflare Workers for demonstration and testing",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "mocks/edge"
    },
    "type": "module",
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "deploy": "seedcord build && cf deploy --prebuilt",
        "codegen": "seedcord codegen",
        "types": "cf workers types",
        "postinstall": "cf workers types",
        "clean": "rm -rf .cloudflare",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "vp fmt --write '**/*.{ts,tsx,json,jsonc,md}' --no-error-on-unmatched-pattern",
        "fmt:check": "vp fmt --check '**/*.{ts,tsx,json,jsonc,md}' --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit"
    },
    "dependencies": {
        "@discordjs/builders": "catalog:deps",
        "@seedcord/http": "workspace:^",
        "discord-api-types": "catalog:deps",
        "envapt": "catalog:peer"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "catalog:peer",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "cf": "catalog:deps",
        "seedcord": "workspace:^"
    }
}
