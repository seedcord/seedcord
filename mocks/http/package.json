{
    "name": "@seedcord/mock-http",
    "type": "module",
    "version": "0.0.13",
    "engines": {
        "node": ">=24.11"
    },
    "private": true,
    "description": "Http-transport mock bot for demonstration and testing",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "mocks/http"
    },
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "start": "pnpm build && node --enable-source-maps dist/index.mjs",
        "codegen": "seedcord codegen",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "prettier --write '**/*.{ts,tsx,json,md}' --cache --no-error-on-unmatched-pattern",
        "fmt:check": "prettier --check '**/*.{ts,tsx,json,md}' --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "tc:watch": "tsc --noEmit --watch"
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "dependencies": {
        "@discordjs/builders": "catalog:deps",
        "@seedcord/http": "workspace:^",
        "discord-api-types": "catalog:deps",
        "envapt": "catalog:peer"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "seedcord": "workspace:^"
    }
}
