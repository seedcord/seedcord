{
    "name": "@seedcord/mock-http",
    "version": "0.0.17",
    "private": true,
    "description": "Http-transport mock bot for demonstration and testing",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "mocks/http"
    },
    "type": "module",
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "start": "vp run build && node --enable-source-maps dist/index.mjs",
        "codegen": "seedcord codegen",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "tc:watch": "tsc --noEmit --watch"
    },
    "dependencies": {
        "@discordjs/builders": "catalog:peer",
        "@seedcord/http": "workspace:^",
        "discord-api-types": "catalog:deps",
        "envapt": "catalog:peer"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "seedcord": "workspace:^"
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
