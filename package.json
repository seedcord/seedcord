{
    "name": "@seedcord/seedcord",
    "version": "0.1.0",
    "description": "A TypeScript framework for Discord bots, typed end to end",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.4.2",
    "scripts": {
        "build": "turbo build --filter='!./apps/*'",
        "build:all": "turbo build",
        "lint": "turbo lint",
        "lint:fix": "turbo lint:fix",
        "lint:md": "markdownlint-cli2",
        "lint:fix:md": "markdownlint-cli2 --fix",
        "fmt": "turbo fmt && pnpm fmt:root",
        "fmt:check": "turbo fmt:check && pnpm fmt:check:root",
        "fmt:root": "prettier --write '*.{json,md,mjs,ts,yml,yaml}' '.changeset/*.md' '.github/**/*.{yml,yaml,md}' --cache --no-error-on-unmatched-pattern",
        "fmt:check:root": "prettier --check '*.{json,md,mjs,ts,yml,yaml}' '.changeset/*.md' '.github/**/*.{yml,yaml,md}' --cache --no-error-on-unmatched-pattern",
        "tc": "turbo tc",
        "tc:root": "tsgo --noEmit -p tsconfig.json",
        "test": "turbo test",
        "check:catalog": "tsx scripts/src/check-workspace-catalog.ts",
        "check:typescript-floor": "tsx scripts/src/check-typescript-floor.ts",
        "lint:changesets": "tsx scripts/src/release/lint-changesets.ts",
        "codegen:check": "pnpm -C mocks/gateway exec seedcord codegen --check && pnpm -C mocks/http exec seedcord codegen --check && pnpm -C mocks/edge exec seedcord codegen --check",
        "prePush": "cross-env-shell TURBO_SCM_BASE=next \"pnpm clean:scratch && pnpm build && pnpm codegen:check && turbo check:catalog tc:root lint:md lint:changesets && turbo tc --affected && turbo lint --affected && turbo fmt:check --affected && pnpm fmt:check:root && turbo test --affected\"",
        "prePush:all": "pnpm clean:scratch && pnpm build && pnpm codegen:check && turbo check:catalog tc:root lint:md lint:changesets && pnpm tc && pnpm lint && pnpm fmt:check && pnpm test",
        "clean": "turbo clean",
        "clean:scratch": "tsx scripts/src/clean-test-scratch.ts",
        "build:clean": "turbo clean && pnpm build",
        "turbo:graph": "turbo build --graph",
        "prepare": "vp config",
        "knip": "knip",
        "react-doctor": "react-doctor --verbose",
        "cs": "changeset",
        "cs:pre:enter": "changeset pre enter next",
        "cs:pre:exit": "changeset pre exit",
        "cs:publish": "changeset publish",
        "cs:status": "changeset status --output .changeset/status.json",
        "cs:version": "cross-env-shell \"NODE_OPTIONS='--import tsx'\" \"changeset version && pnpm tsx scripts/src/release/tidy-changelogs.ts && prettier --write '**/CHANGELOG.md'\"",
        "release": "pnpm build && pnpm cs:publish",
        "release:notes": "tsx scripts/src/release/release-notes.ts",
        "deps:check": "taze major",
        "deps:bump": "taze major -w -i",
        "docs:extract": "pnpm tsx scripts/src/docs/extract-docs.ts -o ./generated --project-folder-url https://github.com/seedcord/seedcord --ref next",
        "docs:artifacts": "pnpm tsx scripts/src/docs/build-docs-artifacts.ts",
        "docs:local": "pnpm docs:extract && pnpm docs:artifacts",
        "docs:sync": "pnpm tsx scripts/src/docs/sync-docs-to-artifacts.ts",
        "docs:purge": "pnpm tsx scripts/src/docs/purge-cdn-cache.ts",
        "docs:upload": "pnpm tsx scripts/src/docs/upload-docs-site.ts",
        "docs:prune": "pnpm tsx scripts/src/docs/prune-docs-site.ts",
        "docs:preview": "pnpm tsx scripts/src/docs/preview-docs.ts"
    },
    "keywords": [
        "discord",
        "discord.js",
        "bot",
        "framework",
        "oop",
        "typescript",
        "cli"
    ],
    "author": "Dhruv <materwelondhruv@gmail.com>",
    "license": "Apache-2.0",
    "devDependencies": {
        "@changesets/cli": "^3.0.2",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@commitlint/types": "^21.2.0",
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@turbo/gen": "^2.11.2",
        "@types/node": "catalog:deps",
        "@typescript/native-preview": "7.0.0-dev.20260630.1",
        "@vitest/coverage-v8": "catalog:test",
        "cross-env": "catalog:deps",
        "eslint": "catalog:eslint",
        "fallow": "^3.11.0",
        "knip": "^6.31.0",
        "markdownlint-cli2": "^0.23.3",
        "prettier": "catalog:deps",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "react-doctor": "^0.9.3",
        "taze": "^21.3.0",
        "tsx": "catalog:deps",
        "turbo": "^2.11.2",
        "typescript": "catalog:peer",
        "vite-plus": "catalog:deps",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": ">=26"
    }
}
