{
    "name": "@seedcord/seedcord",
    "version": "0.1.0",
    "private": true,
    "description": "A TypeScript framework for Discord bots, typed end to end",
    "keywords": [
        "bot",
        "cli",
        "discord",
        "discord.js",
        "framework",
        "oop",
        "typescript"
    ],
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com>",
    "type": "module",
    "scripts": {
        "build": "turbo build --filter=\"!./apps/*\" --filter=\"!@seedcord/mock-edge\"",
        "build:all": "turbo build --filter=\"!@seedcord/mock-edge\"",
        "lint": "turbo lint",
        "lint:fix": "turbo lint:fix",
        "lint:md": "markdownlint-cli2",
        "lint:fix:md": "markdownlint-cli2 --fix",
        "fmt": "vp fmt",
        "fmt:check": "vp fmt --check",
        "fmt:root": "vp fmt '*.{json,md,mjs,ts,yml,yaml}' '.changeset/*.md' '.github/**/*.{yml,yaml,md}' --no-error-on-unmatched-pattern",
        "fmt:check:root": "vp fmt --check '*.{json,md,mjs,ts,yml,yaml}' '.changeset/*.md' '.github/**/*.{yml,yaml,md}' --no-error-on-unmatched-pattern",
        "tc": "turbo tc",
        "tc:root": "tsgo --noEmit -p tsconfig.json",
        "test": "turbo test",
        "check:catalog": "vpx scripts/src/check-workspace-catalog.ts",
        "check:typescript-floor": "vpx scripts/src/check-typescript-floor.ts",
        "lint:changesets": "vpx scripts/src/release/lint-changesets.ts",
        "codegen:check": "vp -C mocks/gateway exec seedcord codegen --check && vp -C mocks/http exec seedcord codegen --check && vp -C mocks/edge exec seedcord codegen --check",
        "prePush": "cross-env TURBO_SCM_BASE=next vp run prePush:run",
        "prePush:run": "vp run clean:scratch && vp run build && vp run codegen:check && turbo check:catalog tc:root lint:md lint:changesets && turbo tc --affected && turbo lint --affected && vp fmt --check --no-error-on-unmatched-pattern && turbo test --affected",
        "prePush:all": "vp run clean:scratch && vp run build && vp run codegen:check && turbo check:catalog tc:root lint:md lint:changesets && vp run tc && vp run lint && vp fmt --check --no-error-on-unmatched-pattern && vp run test",
        "clean": "turbo clean",
        "clean:scratch": "vpx scripts/src/clean-test-scratch.ts",
        "build:clean": "turbo clean && vp run build",
        "turbo:graph": "turbo build --graph",
        "prepare": "vp config",
        "knip": "knip",
        "react-doctor": "react-doctor --verbose",
        "cs": "changeset",
        "cs:pre:enter": "changeset pre enter next",
        "cs:pre:exit": "changeset pre exit",
        "cs:publish": "changeset publish",
        "cs:status": "changeset status --output .changeset/status.json",
        "cs:version": "cross-env \"NODE_OPTIONS='--import jiti/register'\" vp run cs:version:run",
        "cs:version:run": "changeset version && vpx scripts/src/release/tidy-changelogs.ts && vp fmt '**/CHANGELOG.md'",
        "release": "vp run build && vp run cs:publish",
        "release:notes": "vpx scripts/src/release/release-notes.ts",
        "release:preview": "vpx scripts/src/release/preview-release.ts",
        "deps:check": "taze major",
        "deps:bump": "taze major -w -i",
        "docs:extract": "vpx scripts/src/docs/extract-docs.ts -o ./generated --project-folder-url https://github.com/seedcord/seedcord --ref next",
        "docs:artifacts": "vpx scripts/src/docs/build-docs-artifacts.ts",
        "docs:local": "vp run docs:extract && vp run docs:artifacts",
        "docs:sync": "vpx scripts/src/docs/sync-docs-to-artifacts.ts",
        "docs:purge": "vpx scripts/src/docs/purge-cdn-cache.ts",
        "docs:upload": "vpx scripts/src/docs/upload-docs-site.ts",
        "docs:prune": "vpx scripts/src/docs/prune-docs-site.ts",
        "docs:preview": "vpx scripts/src/docs/preview-docs.ts"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.2",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@commitlint/types": "^21.2.0",
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@turbo/gen": "^2.11.2",
        "@types/node": "catalog:deps",
        "@typescript/native-preview": "7.0.0-dev.20260630.1",
        "@vitest/coverage-v8": "catalog:test",
        "cross-env": "catalog:deps",
        "eslint": "catalog:eslint",
        "jiti": "catalog:deps",
        "knip": "^6.31.0",
        "markdownlint-cli2": "^0.24.0",
        "react-doctor": "^0.9.3",
        "taze": "^21.3.0",
        "turbo": "^2.11.2",
        "typescript": "catalog:peer",
        "vite-plus": "1.4.0",
        "vitest": "catalog:test"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.14.0"
        },
        "runtime": [
            {
                "name": "node",
                "version": "^26"
            },
            {
                "name": "bun",
                "version": "1.4.2"
            }
        ]
    },
    "engines": {
        "node": ">=26.12.1"
    },
    "packageManager": "pnpm@12.14.0"
}
