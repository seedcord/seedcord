{
    "name": "@seedcord/seedcord",
    "version": "0.1.0",
    "description": "A Discord bot framework built on top of Discord.js",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.3.4",
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "lint:fix": "turbo lint:fix",
        "fmt": "turbo fmt",
        "fmt:check": "turbo fmt:check",
        "tc": "turbo tc",
        "tc:root": "tsgo --noEmit -p tsconfig.json",
        "test": "turbo test",
        "lint:md": "markdownlint-cli2",
        "lint:fix:md": "markdownlint-cli2 --fix",
        "check:catalog": "tsx scripts/src/check-workspace-catalog.ts",
        "lint:changesets": "tsx scripts/src/release/lint-changesets.ts",
        "codegen:check": "pnpm -C mocks/gateway exec seedcord codegen --check && pnpm -C mocks/http exec seedcord codegen --check",
        "prePush": "pnpm clean:scratch && pnpm build && pnpm codegen:check && turbo check:catalog tc:root lint:md lint:changesets && pnpm tc && pnpm lint && pnpm fmt:check && pnpm test",
        "prePush:affected": "pnpm clean:scratch && pnpm build && pnpm codegen:check && turbo check:catalog tc:root lint:md lint:changesets && turbo tc --affected && turbo lint --affected && turbo fmt:check --affected && turbo test --affected",
        "lint-staged": "lint-staged",
        "clean": "turbo clean",
        "clean:scratch": "tsx scripts/src/clean-test-scratch.ts",
        "clean:node": "find . -name node_modules -type d -prune -exec rm -rf '{}' +",
        "turbo:rebuild": "turbo clean && turbo build",
        "turbo:prebuild": "turbo clean && turbo lint && turbo tc",
        "turbo:prune": "turbo prune",
        "turbo:graph": "turbo build --graph",
        "turbo:trace": "turbo build --trace",
        "prepare": "husky",
        "knip": "knip",
        "react-doctor": "react-doctor --verbose",
        "cs": "changeset",
        "cs:publish": "changeset publish",
        "cs:status": "changeset status --output .changeset/status.json",
        "cs:preview": "changeset preview",
        "release": "pnpm run build && pnpm run cs:publish",
        "release:notes": "tsx scripts/src/release/release-notes.ts",
        "release:version": "NODE_OPTIONS='--import tsx' changeset version && pnpm tsx scripts/src/release/tidy-changelogs.ts && prettier --write '**/CHANGELOG.md'",
        "prepublishOnly": "pnpm run clean && pnpm run build",
        "deps:check": "taze major",
        "deps:bump": "taze major -w -i",
        "docs:extract": "pnpm tsx scripts/src/docs/extract-docs.ts -o ./generated --project-folder-url https://github.com/seedcord/seedcord --ref next",
        "docs:artifacts": "pnpm tsx scripts/src/docs/build-docs-artifacts.ts",
        "docs:artifacts:fixtures": "pnpm tsx scripts/src/docs/build-docs-artifacts.ts --fixtures",
        "docs:local": "pnpm docs:extract && pnpm docs:artifacts",
        "docs:sync": "pnpm tsx scripts/src/docs/sync-docs-to-artifacts.ts",
        "docs:purge": "pnpm tsx scripts/src/docs/purge-cdn-cache.ts"
    },
    "keywords": [
        "discord",
        "discord.js",
        "bot",
        "framework",
        "oop",
        "typescript",
        "cli"
    ],
    "author": "Dhruv <materwelondhruv@gmail.com>",
    "license": "Apache-2.0",
    "devDependencies": {
        "@changesets/cli": "^3.0.2",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@turbo/gen": "^2.10.8",
        "@types/node": "catalog:deps",
        "@typescript/native-preview": "7.0.0-dev.20260630.1",
        "@vitest/coverage-v8": "catalog:test",
        "eslint": "catalog:eslint",
        "fallow": "^3.11.0",
        "husky": "^9.1.7",
        "knip": "^6.31.0",
        "lint-staged": "^17.3.0",
        "markdownlint-cli2": "^0.23.2",
        "prettier": "catalog:deps",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "react-doctor": "^0.9.3",
        "taze": "^19.17.1",
        "tsdown": "catalog:deps",
        "tsx": "catalog:deps",
        "turbo": "^2.10.8",
        "typescript": "catalog:peer",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": ">=26"
    }
}
