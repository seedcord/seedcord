{
    "name": "@seedcord/seedcord",
    "version": "0.1.0",
    "description": "A Discord bot framework built on top of Discord.js",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.6.0",
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "lint:fix": "turbo lint:fix",
        "fmt": "turbo fmt",
        "fmt:check": "turbo fmt:check",
        "tc": "turbo tc",
        "tc:scripts": "tsgo --noEmit -p scripts/tsconfig.json",
        "tc:root": "tsgo --noEmit -p tsconfig.json",
        "test": "turbo test",
        "test:scripts": "vitest run scripts/tests --coverage=false",
        "lint:scripts": "eslint 'scripts/**/*.{ts,tsx}' --cache",
        "lint:fix:scripts": "eslint 'scripts/**/*.{ts,tsx}' --fix --cache",
        "lint:md": "markdownlint-cli2",
        "lint:fix:md": "markdownlint-cli2 --fix",
        "check:catalog": "tsx scripts/check-workspace-catalog.ts",
        "codegen:check": "pnpm -C mock exec seedcord codegen --check",
        "prePush": "pnpm check:catalog && pnpm build && pnpm codegen:check && pnpm tc && pnpm tc:scripts && pnpm tc:root && pnpm lint && pnpm lint:scripts && pnpm fmt:check && pnpm lint:md && pnpm test && pnpm test:scripts",
        "lint-staged": "lint-staged",
        "clean": "turbo clean",
        "clean:node": "find . -name node_modules -type d -prune -exec rm -rf '{}' +",
        "turbo:rebuild": "turbo clean && turbo build",
        "turbo:prebuild": "turbo clean && turbo lint && turbo tc",
        "turbo:prune": "turbo prune",
        "turbo:graph": "turbo build --graph",
        "turbo:trace": "turbo build --trace",
        "prepare": "husky",
        "knip": "knip",
        "react-doctor": "react-doctor --verbose",
        "cs": "changeset",
        "cs:publish": "changeset publish",
        "cs:status": "changeset status --output .changeset/status.json",
        "cs:preview": "changeset preview",
        "release": "pnpm run build && pnpm run cs:publish",
        "prepublishOnly": "pnpm run clean && pnpm run build",
        "bump:deps:pkgs": "for dir in packages/*/ mock/; do [ -d \"$dir\" ] || continue; echo \"Updating $dir...\"; (cd \"$dir\" && pnpm update --latest); done",
        "bump:deps:apps": "for dir in apps/*/; do echo \"Updating $dir...\"; (cd \"$dir\" && pnpm update --latest); done",
        "bump:deps": "pnpm run bump:deps:pkgs && pnpm run bump:deps:apps",
        "docs:extract": "pnpm tsx scripts/docs/extract-docs.ts -o ./generated -p ./packages --project-folder-url https://github.com/seedcord/seedcord --ref next",
        "docs:artifacts": "pnpm tsx scripts/docs/build-docs-artifacts.ts",
        "docs:artifacts:fixtures": "pnpm tsx scripts/docs/build-docs-artifacts.ts --fixtures",
        "docs:local": "pnpm docs:extract && pnpm docs:artifacts",
        "docs:sync": "pnpm tsx scripts/docs/sync-docs-to-artifacts.ts",
        "docs:purge": "pnpm tsx scripts/docs/purge-cdn-cache.ts",
        "docs:smoke": "pnpm docs:extract && pnpm --filter @seedcord/docs-engine run smoke ./generated -o ./debugging/samples"
    },
    "keywords": [
        "discord",
        "discord.js",
        "bot",
        "framework",
        "oop",
        "typescript",
        "cli"
    ],
    "author": "Dhruv <materwelondhruv@gmail.com>",
    "license": "Apache-2.0",
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1071.0",
        "@changesets/cli": "^2.31.0",
        "@commitlint/cli": "^21.0.2",
        "@commitlint/config-conventional": "^21.0.2",
        "@seedcord/docs-engine": "workspace:*",
        "@seedcord/docs-generator": "workspace:*",
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@turbo/gen": "^2.9.18",
        "@types/node": "catalog:deps",
        "@typescript/native-preview": "7.0.0-dev.20260630.1",
        "@vitest/coverage-v8": "catalog:test",
        "envapt": "catalog:deps",
        "eslint": "catalog:eslint",
        "husky": "^9.1.7",
        "knip": "^6.17.1",
        "lint-staged": "^17.0.7",
        "markdownlint-cli2": "^0.22.1",
        "prettier": "catalog:deps",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "react-doctor": "^0.5.6",
        "tsdown": "catalog:deps",
        "tsx": "catalog:deps",
        "turbo": "^2.9.18",
        "typescript": "catalog:peer",
        "vite": "catalog:deps",
        "vitest": "catalog:test"
    },
    "engines": {
        "node": ">=24.3"
    }
}
