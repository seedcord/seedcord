{
    "$schema": "https://www.schemastore.org/tsconfig.json",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": ".",
        "paths": {
            "#src/*": ["./src/*"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "eslint.config.ts", "vite.config.ts"],
    "exclude": ["node_modules"]
}
