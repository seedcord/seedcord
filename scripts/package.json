{
    "name": "@seedcord/scripts",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=26"
    },
    "private": true,
    "description": "Repo scripts for docs, releases, and workspace checks",
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "scripts"
    },
    "scripts": {
        "lint": "eslint '**/*.ts' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.ts' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "prettier --write '**/*.{ts,json,md}' --cache --no-error-on-unmatched-pattern",
        "fmt:check": "prettier --check '**/*.{ts,json,md}' --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1101.0",
        "@changesets/parse": "^1.0.0",
        "@manypkg/get-packages": "^3.1.0",
        "@seedcord/docs-engine": "workspace:^",
        "@seedcord/docs-generator": "workspace:^",
        "envapt": "catalog:peer",
        "yaml": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@types/node": "catalog:deps",
        "@vitest/coverage-v8": "catalog:test",
        "typescript": "catalog:peer",
        "vite": "catalog:deps",
        "vitest": "catalog:test"
    }
}
