{
    "name": "@seedcord/mock",
    "type": "module",
    "version": "0.2.19-next.0",
    "private": true,
    "description": "Mock bot for demonstration and testing purposes",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "mock"
    },
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "start": "pnpm build && node --enable-source-maps dist/index.mjs",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md}' --cache",
        "tc": "tsc --noEmit",
        "tc:watch": "tsc --noEmit --watch"
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "dependencies": {
        "@seedcord/plugins": "workspace:*",
        "discord.js": "catalog:peer",
        "envapt": "catalog:deps",
        "mongoose": "catalog:peer",
        "reflect-metadata": "catalog:peer",
        "seedcord": "workspace:*"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@seedcord/cli": "workspace:*"
    }
}
