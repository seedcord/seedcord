{
    "name": "@seedcord/plugin-i18n",
    "version": "0.1.0",
    "description": "Translate a seedcord bot's replies and commands into each user's Discord language with Fluent",
    "keywords": [
        "discord-bot",
        "fluent",
        "i18n",
        "localization",
        "plugin",
        "seedcord"
    ],
    "homepage": "https://seedcord.org",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "plugins/i18n"
    },
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@fluent/bundle": "^0.19.1",
        "@fluent/syntax": "^0.19.0",
        "@seedcord/errors": "workspace:^",
        "@seedcord/utils": "workspace:^",
        "discord-api-types": "catalog:deps",
        "type-fest": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/core": "workspace:^",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/logger": "workspace:^",
        "@seedcord/prose": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vite-config": "workspace:^"
    },
    "peerDependencies": {
        "@seedcord/core": "workspace:>=0.14.0-next.0",
        "typescript": "catalog:consumerTypes"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
