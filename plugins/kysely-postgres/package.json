{
    "name": "@seedcord/plugin-kysely-postgres",
    "version": "0.7.0",
    "description": "Connect a seedcord bot to Postgres with Kysely",
    "keywords": [
        "database",
        "discord-bot",
        "kysely",
        "plugin",
        "postgres",
        "seedcord"
    ],
    "homepage": "https://seedcord.org",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "plugins/kysely-postgres"
    },
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@seedcord/errors": "workspace:^",
        "@seedcord/logger": "workspace:^",
        "@seedcord/types": "workspace:^",
        "@seedcord/utils": "workspace:^",
        "reflect-metadata": "catalog:deps",
        "type-fest": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/core": "workspace:^",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/gateway": "workspace:^",
        "@seedcord/http": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@types/pg": "catalog:deps",
        "envapt": "catalog:peer",
        "kysely": "catalog:peer",
        "pg": "catalog:peer",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@seedcord/core": "workspace:>=0.11.0-next.0",
        "envapt": "catalog:peer",
        "kysely": "catalog:peer",
        "pg": "catalog:peer",
        "typescript": "catalog:consumerTypes"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
