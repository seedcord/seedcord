{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
            "env": ["SEEDCORD_DOCS_INDEX_URL"]
        },
        "//#docs:extract": {
            "dependsOn": [
                "@seedcord/docs-generator#build",
                "@seedcord/core#build",
                "@seedcord/errors#build",
                "@seedcord/eslint-config#build",
                "@seedcord/eslint-plugin#build",
                "@seedcord/event-emitter#build",
                "@seedcord/gateway#build",
                "@seedcord/http#build",
                "@seedcord/logger#build",
                "@seedcord/plugin-kysely-postgres#build",
                "@seedcord/plugin-mongoose#build",
                "@seedcord/rate-limiter#build",
                "@seedcord/types#build",
                "@seedcord/utils#build",
                "eslint-plugin-discordjs#build",
                "seedcord#build"
            ],
            "inputs": [
                "scripts/docs/extract-docs.ts",
                "packages/*/dist/**/*.d.mts",
                "packages/*/package.json",
                "plugins/*/dist/**/*.d.mts",
                "plugins/*/package.json",
                "cli/*/dist/**/*.d.mts",
                "cli/*/package.json",
                "tooling/*/dist/**/*.d.mts",
                "tooling/*/package.json"
            ],
            "outputs": ["generated/*.json"]
        },
        "//#docs:artifacts": {
            "dependsOn": ["//#docs:extract", "@seedcord/docs-engine#build"],
            "inputs": ["scripts/docs/build-docs-artifacts.ts", "generated/*.json"],
            "outputs": ["generated/artifacts/**"]
        },
        "@seedcord/docs#build": {
            "dependsOn": ["^build", "//#docs:artifacts"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**"],
            "env": ["SEEDCORD_DOCS_INDEX_URL"]
        },
        "//#check:catalog": {
            "inputs": ["scripts/check-workspace-catalog.ts", "pnpm-workspace.yaml", "**/package.json"]
        },
        "//#tc:scripts": {
            "dependsOn": ["@seedcord/docs-engine#build", "@seedcord/docs-generator#build"],
            "inputs": [
                "scripts/**/*.ts",
                "scripts/tsconfig.json",
                "tooling/tsconfig/**",
                "tooling/docs-engine/dist/**/*.d.mts",
                "tooling/docs-generator/dist/**/*.d.mts"
            ]
        },
        "//#tc:root": {
            "dependsOn": [
                "@seedcord/docs-engine#build",
                "@seedcord/docs-generator#build",
                "@seedcord/vitest-config#build"
            ],
            "inputs": [
                "*.ts",
                "turbo/**/*.ts",
                "scripts/**/*.ts",
                "tsconfig.json",
                "tooling/tsconfig/**",
                "tooling/docs-engine/dist/**/*.d.mts",
                "tooling/docs-generator/dist/**/*.d.mts",
                "tooling/vitest-config/dist/**/*.d.mts"
            ]
        },
        "//#lint:scripts": {
            "dependsOn": [
                "@seedcord/docs-engine#build",
                "@seedcord/docs-generator#build",
                "@seedcord/eslint-config#build"
            ],
            "inputs": [
                "scripts/**/*.{ts,tsx}",
                "scripts/tsconfig.json",
                "eslint.config.*",
                "tooling/docs-engine/dist/**/*.d.mts",
                "tooling/docs-generator/dist/**/*.d.mts"
            ]
        },
        "//#lint:md": {
            "inputs": ["**/*.md", ".markdownlint-cli2.jsonc", ".markdownlint.json"]
        },
        "//#test:scripts": {
            "dependsOn": [
                "@seedcord/docs-engine#build",
                "@seedcord/docs-generator#build",
                "@seedcord/vitest-config#build"
            ],
            "inputs": [
                "scripts/**/*.ts",
                "vitest.config.ts",
                "tooling/docs-engine/dist/**/*.d.mts",
                "tooling/docs-generator/dist/**/*.d.mts",
                "tooling/vitest-config/dist/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^build", "@seedcord/eslint-config#build"],
            "inputs": ["$TURBO_DEFAULT$", ".eslintrc*", "eslint.config.*"]
        },
        "lint:fix": {
            "dependsOn": ["@seedcord/eslint-config#build"],
            "inputs": ["$TURBO_DEFAULT$", ".eslintrc*", "eslint.config.*"],
            "cache": false
        },
        "tc": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
        },
        "test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*", "src/**", "tests/**"]
        },
        "@seedcord/core#lint": {
            "dependsOn": ["^build", "@seedcord/core#build"],
            "inputs": ["$TURBO_DEFAULT$", ".eslintrc*", "eslint.config.*"]
        },
        "@seedcord/core#tc": {
            "dependsOn": ["^build", "@seedcord/core#build"],
            "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
        },
        "@seedcord/core#test": {
            "dependsOn": ["^build", "@seedcord/core#build"],
            "inputs": ["$TURBO_DEFAULT$", "vitest.config.*", "src/**", "tests/**"]
        },
        "@seedcord/http#test": {
            "dependsOn": ["^build", "@seedcord/http#build"],
            "inputs": ["$TURBO_DEFAULT$", "vitest.config.*", "src/**", "tests/**"]
        },
        "@seedcord/docs-engine#test": {
            "dependsOn": ["^build", "@seedcord/docs-generator#test"],
            "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*", "src/**", "tests/**"]
        },
        "test:watch": {
            "cache": false,
            "persistent": true
        },
        "coverage": {
            "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*", "src/**", "tests/**"],
            "outputs": ["coverage/**"]
        },
        "fmt": {
            "dependsOn": ["@seedcord/eslint-config#build"],
            "inputs": ["$TURBO_DEFAULT$", ".prettierrc*", "prettier.config.*"],
            "cache": false
        },
        "fmt:check": {
            "dependsOn": ["@seedcord/eslint-config#build"],
            "inputs": ["$TURBO_DEFAULT$", ".prettierrc*", "prettier.config.*"]
        },
        "clean": {
            "cache": false
        }
    },
    "globalDependencies": ["package.json", "pnpm-workspace.yaml", "turbo.json", ".env*"],
    "globalEnv": ["NODE_ENV", "ENVIRONMENT", "ENV"],
    "cacheMaxAge": "48h"
}
