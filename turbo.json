{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"],
            "env": ["SEEDCORD_DOCS_INDEX_URL"]
        },
        "//#docs:extract": {
            "dependsOn": [
                "@seedcord/docs-generator#build",
                "@seedcord/core#build",
                "@seedcord/custom-id#build",
                "@seedcord/errors#build",
                "@seedcord/eslint-config#build",
                "@seedcord/eslint-plugin#build",
                "@seedcord/event-emitter#build",
                "@seedcord/gateway#build",
                "@seedcord/http#build",
                "@seedcord/logger#build",
                "@seedcord/plugin-kysely-postgres#build",
                "@seedcord/plugin-mongoose#build",
                "@seedcord/rate-limiter#build",
                "@seedcord/types#build",
                "@seedcord/utils#build",
                "discord-component-embed#build",
                "eslint-plugin-discordjs#build",
                "seedcord#build"
            ],
            "inputs": [
                "scripts/src/docs/extract-docs.ts",
                "packages/*/dist/**/*.d.mts",
                "packages/*/package.json",
                "plugins/*/dist/**/*.d.mts",
                "plugins/*/package.json",
                "cli/*/dist/**/*.d.mts",
                "cli/*/package.json",
                "tooling/*/dist/**/*.d.mts",
                "tooling/*/package.json"
            ],
            "outputs": ["generated/*.json"]
        },
        "//#docs:artifacts": {
            "dependsOn": ["//#docs:extract", "@seedcord/docs-engine#build"],
            "inputs": ["scripts/src/docs/build-docs-artifacts.ts", "generated/*.json"],
            "outputs": ["generated/artifacts/**"]
        },
        "@seedcord/docs#build": {
            "dependsOn": ["^build", "//#docs:artifacts"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**"],
            "env": ["SEEDCORD_DOCS_INDEX_URL"]
        },
        "//#check:catalog": {
            "inputs": ["scripts/src/**/*.ts", "pnpm-workspace.yaml", "**/package.json"]
        },
        "//#lint:changesets": {
            "inputs": [".changeset/*.md", "scripts/src/**/*.ts", "**/package.json"]
        },
        "//#tc:root": {
            "dependsOn": ["@seedcord/eslint-config#build"],
            "inputs": ["*.ts", "turbo/**/*.ts", "tsconfig.json", "tooling/tsconfig/**", "tooling/eslint-config/dist/**"]
        },
        "//#lint:md": {
            "inputs": ["**/*.md", ".markdownlint-cli2.jsonc", ".markdownlint.json"]
        },
        "lint": {
            "dependsOn": ["^build", "@seedcord/eslint-config#build"]
        },
        "lint:fix": {
            "dependsOn": ["@seedcord/eslint-config#build"],
            "cache": false
        },
        "tc": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "@seedcord/core#lint": {
            "dependsOn": ["^build", "@seedcord/core#build"]
        },
        "@seedcord/core#tc": {
            "dependsOn": ["^build", "@seedcord/core#build"]
        },
        "@seedcord/core#test": {
            "dependsOn": ["^build", "@seedcord/core#build"]
        },
        "@seedcord/http#test": {
            "dependsOn": ["^build", "@seedcord/http#build"]
        },
        "@seedcord/guide#test": {
            "dependsOn": ["^build", "//#docs:artifacts"]
        },
        "@seedcord/docs-engine#test": {
            "dependsOn": ["^build", "@seedcord/docs-generator#test"]
        },
        "seedcord#test": {
            "dependsOn": ["^build", "seedcord#build"]
        },
        "fmt": {
            "dependsOn": ["@seedcord/eslint-config#build"],
            "cache": false
        },
        "fmt:check": {
            "dependsOn": ["@seedcord/eslint-config#build"]
        },
        "clean": {
            "cache": false
        }
    },
    "globalDependencies": ["package.json", "pnpm-workspace.yaml", "turbo.json", ".env*"],
    "globalEnv": ["NODE_ENV", "ENVIRONMENT", "ENV", "TWOSLASH"],
    "cacheMaxAge": "48h"
}
