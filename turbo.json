{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
            "env": ["SEEDCORD_DOCS_INDEX_URL"]
        },
        "//#docs:extract": {
            "dependsOn": ["@seedcord/docs-generator#build"],
            "inputs": ["scripts/docs/extract-docs.ts", "packages/*/dist/**/*.d.mts", "packages/*/package.json"],
            "outputs": ["generated/**"]
        },
        "//#check:catalog": {
            "inputs": ["scripts/check-workspace-catalog.ts", "pnpm-workspace.yaml", "**/package.json"]
        },
        "//#tc:scripts": {
            "dependsOn": ["@seedcord/docs-engine#build", "@seedcord/docs-generator#build"],
            "inputs": [
                "scripts/**/*.ts",
                "scripts/tsconfig.json",
                "packages/tsconfig/**",
                "packages/docs-engine/dist/**/*.d.mts",
                "packages/docs-generator/dist/**/*.d.mts"
            ]
        },
        "//#tc:root": {
            "dependsOn": ["@seedcord/docs-engine#build", "@seedcord/docs-generator#build"],
            "inputs": [
                "*.ts",
                "turbo/**/*.ts",
                "scripts/**/*.ts",
                "tsconfig.json",
                "packages/tsconfig/**",
                "packages/docs-engine/dist/**/*.d.mts",
                "packages/docs-generator/dist/**/*.d.mts"
            ]
        },
        "//#lint:scripts": {
            "dependsOn": ["@seedcord/docs-engine#build", "@seedcord/docs-generator#build"],
            "inputs": [
                "scripts/**/*.{ts,tsx}",
                "scripts/tsconfig.json",
                "eslint.config.*",
                "packages/docs-engine/dist/**/*.d.mts",
                "packages/docs-generator/dist/**/*.d.mts"
            ]
        },
        "//#lint:md": {
            "inputs": ["**/*.md", ".markdownlint-cli2.jsonc", ".markdownlint.json"]
        },
        "//#test:scripts": {
            "dependsOn": ["@seedcord/docs-engine#build", "@seedcord/docs-generator#build"],
            "inputs": [
                "scripts/**/*.ts",
                "vitest.config.ts",
                "packages/docs-engine/dist/**/*.d.mts",
                "packages/docs-generator/dist/**/*.d.mts"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".eslintrc*", "eslint.config.*"]
        },
        "lint:fix": {
            "inputs": ["$TURBO_DEFAULT$", ".eslintrc*", "eslint.config.*"],
            "cache": false
        },
        "tc": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"]
        },
        "test": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*", "src/**", "tests/**"]
        },
        "@seedcord/docs-engine#test": {
            "dependsOn": ["^build", "@seedcord/docs-generator#test"],
            "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*", "src/**", "tests/**"]
        },
        "test:watch": {
            "cache": false,
            "persistent": true
        },
        "coverage": {
            "inputs": ["$TURBO_DEFAULT$", "jest.config.*", "vitest.config.*", "src/**", "tests/**"],
            "outputs": ["coverage/**"]
        },
        "fmt": {
            "inputs": ["$TURBO_DEFAULT$", ".prettierrc*", "prettier.config.*"],
            "cache": false
        },
        "fmt:check": {
            "inputs": ["$TURBO_DEFAULT$", ".prettierrc*", "prettier.config.*"]
        },
        "clean": {
            "cache": false
        }
    },
    "globalDependencies": ["package.json", "pnpm-workspace.yaml", "turbo.json", ".env*"],
    "globalEnv": ["NODE_ENV", "ENVIRONMENT", "ENV"],
    "cacheMaxAge": "48h"
}
