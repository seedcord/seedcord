{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/base",
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "jsx": "preserve",
        "rootDir": ".",
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "@/*": ["./src/*"],
            "@components/*": ["./src/components/*"],
            "@ui/*": ["./src/components/ui/*"],
            "@lib/*": ["./src/lib/*"],
            "@store/*": ["./src/store/*"],
            "@styles/*": ["./src/app/*"]
        },
        "incremental": true,
        "esModuleInterop": true
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "next.config.ts",
        "vitest.config.ts",
        ".next/types/**/*.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
