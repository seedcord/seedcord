# SEEDCORD_DOCS_INDEX_URL (OPTIONAL)
#
# URL the docs engine fetches the artifact index from. The fetcher supports
# file://, http://, and https://.
#
# When unset, the site falls back to the local generated index on disk:
#   file://<repo>/generated/artifacts/index.json
# Run `pnpm docs:extract` first so that file exists. Leave this commented out
# for normal local development.
#
# Production: point at the R2-backed CDN index.
#   SEEDCORD_DOCS_INDEX_URL=https://cdn.seedcord.org/index.json
#
# Per-deployment preview: a same-origin index served alongside the build.
#   SEEDCORD_DOCS_INDEX_URL=/artifacts/index.json
#
# SEEDCORD_DOCS_INDEX_URL=
