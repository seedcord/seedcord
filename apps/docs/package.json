{
    "name": "@seedcord/docs",
    "version": "0.1.18",
    "private": true,
    "type": "module",
    "imports": {
        "#tests/*": "./tests/*",
        "#src/*": "./src/*",
        "#components/*": "./src/components/*",
        "#ui/*": "./src/components/ui/*",
        "#lib/*": "./src/lib/*",
        "#store/*": "./src/store/*",
        "#styles/*": "./src/app/*"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "check:links": "tsx check-links.ts",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "vp fmt --write '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "fmt:check": "vp fmt --check '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@seedcord/docs-engine": "workspace:^",
        "@seedcord/docs-generator": "workspace:^",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/types": "workspace:^",
        "@seedcord/ui": "workspace:^",
        "@tailwindcss/postcss": "catalog:deps",
        "discord-component-embed": "workspace:^",
        "envapt": "catalog:peer",
        "github-slugger": "^2.0.0",
        "isomorphic-dompurify": "^4.4.0",
        "lucide-react": "catalog:deps",
        "marked": "^18.0.14",
        "motion": "catalog:deps",
        "next": "catalog:deps",
        "postcss": "^8.5.28",
        "prettier": "catalog:deps",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "shiki": "catalog:deps",
        "tailwindcss": "catalog:deps",
        "takumi-js": "catalog:deps",
        "type-fest": "catalog:deps",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@testing-library/dom": "catalog:test",
        "@testing-library/jest-dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "@vitest/coverage-v8": "catalog:test",
        "eslint": "^9.39.4",
        "eslint-config-next": "catalog:eslint",
        "eslint-plugin-better-tailwindcss": "catalog:eslint",
        "eslint-plugin-react-compiler": "catalog:eslint",
        "eslint-plugin-tailwind-canonical-classes": "catalog:eslint",
        "jsdom": "catalog:test",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "tsx": "catalog:deps",
        "typescript": "catalog:peer",
        "vitest": "catalog:test",
        "wrangler": "catalog:peer"
    },
    "engines": {
        "node": ">=24.11"
    }
}
