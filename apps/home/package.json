{
    "name": "@seedcord/home",
    "version": "0.0.3",
    "private": true,
    "type": "module",
    "imports": {
        "#tests/*": "./tests/*.ts",
        "#src/*": "./src/*.ts",
        "#components/*": "./src/components/*",
        "#ui/*": "./src/components/ui/*",
        "#lib/*": "./src/lib/*",
        "#styles/*": "./src/app/*.ts"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "vp dlx serve dist",
        "deploy": "wrangler deploy",
        "deploy:preview": "wrangler versions upload",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev"
    },
    "dependencies": {
        "@fumari/image-size": "^0.1.1",
        "@seedcord/ui": "workspace:^",
        "discord-component-embed": "workspace:^",
        "fumadocs-core": "catalog:deps",
        "fumadocs-mdx": "catalog:deps",
        "lucide-react": "catalog:deps",
        "motion": "catalog:deps",
        "next": "catalog:deps",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "takumi-js": "catalog:deps",
        "unist-util-visit": "catalog:deps",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@mdx-js/mdx": "catalog:deps",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@tailwindcss/postcss": "catalog:deps",
        "@types/hast": "catalog:deps",
        "@types/mdast": "catalog:deps",
        "@types/mdx": "catalog:deps",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "eslint": "^9.39.4",
        "eslint-config-next": "catalog:eslint",
        "eslint-plugin-better-tailwindcss": "catalog:eslint",
        "eslint-plugin-tailwind-canonical-classes": "catalog:eslint",
        "mdast-util-to-hast": "catalog:deps",
        "mdast-util-to-markdown": "catalog:deps",
        "prettier": "catalog:deps",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "schema-dts": "^2.1.0",
        "tailwindcss": "catalog:deps",
        "typescript": "catalog:peer",
        "vfile": "catalog:deps",
        "vitest": "catalog:test",
        "wrangler": "catalog:peer"
    },
    "engines": {
        "node": "^24.22.1 || >=26.12.1"
    }
}
