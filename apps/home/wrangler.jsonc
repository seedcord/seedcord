{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "seedcord-home",
    "compatibility_date": "2026-06-23",
    "main": "./worker.ts",
    "routes": [
        { "pattern": "seedcord.org", "custom_domain": true },
        { "pattern": "www.seedcord.org", "custom_domain": true }
    ],
    "assets": {
        "directory": "./out",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        // route every request through worker.ts so it can noindex non-production hosts
        "run_worker_first": true
    }
}
