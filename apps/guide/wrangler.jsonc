{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "seedcord-guide",
    "compatibility_date": "2026-06-23",
    "main": "./worker.ts",
    // a route takes precedence over the home worker's custom domain on the same host
    "routes": [
        { "pattern": "seedcord.org/guide", "zone_name": "seedcord.org" },
        { "pattern": "seedcord.org/guide/*", "zone_name": "seedcord.org" }
    ],
    "workers_dev": false,
    "assets": {
        // next.config.ts writes the export into dist/guide
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        // worker.ts serves the .md twin when a request accepts markdown
        // cloudflare skips _headers for anything the worker returns
        "run_worker_first": ["/*", "!/guide/_next/static/*"]
    }
}
