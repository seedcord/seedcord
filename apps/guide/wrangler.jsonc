{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "seedcord-guide",
    "compatibility_date": "2026-08-04",
    "main": "./worker.ts",
    // a route takes precedence over the home worker's custom domain on the same host
    "routes": [
        { "pattern": "seedcord.org/guide", "zone_name": "seedcord.org" },
        { "pattern": "seedcord.org/guide/*", "zone_name": "seedcord.org" }
    ],
    "workers_dev": false,
    "assets": {
        // next.config.ts writes the export into dist/guide
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        // worker.ts serves the .md twin when a request accepts markdown
        // cloudflare skips _headers for anything the worker returns
        "run_worker_first": ["/*", "!/guide/_next/static/*"]
    },
    "ai": { "binding": "AI" },
    // 30 searches a minute per visitor ip is a guess. nothing has measured real traffic yet
    "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
    "env": {
        "preview": {
            "routes": [
                { "pattern": "preview.seedcord.org/guide", "zone_name": "seedcord.org" },
                { "pattern": "preview.seedcord.org/guide/*", "zone_name": "seedcord.org" }
            ],
            // wrangler doesn't copy top-level bindings into an env
            "ai": { "binding": "AI" },
            "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }]
        }
    }
}
