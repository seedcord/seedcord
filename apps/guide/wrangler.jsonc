{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "seedcord-guide",
    "compatibility_date": "2026-06-23",
    "main": "./worker.ts",
    // custom domains write their own DNS record and cert
    "routes": [{ "pattern": "guide.seedcord.org", "custom_domain": true }],
    "assets": {
        "directory": "./out",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        // worker.ts serves the .md twin when a request accepts markdown
        // cloudflare skips _headers for anything the worker returns
        "run_worker_first": ["/*", "!/_next/static/*"]
    }
}
