{
    "name": "@seedcord/guide",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=24.11"
    },
    "private": true,
    "scripts": {
        "dev": "TWOSLASH=0 next dev",
        "dev:twoslash": "NODE_OPTIONS=--max-old-space-size=8192 next dev",
        "build": "NODE_OPTIONS=--max-old-space-size=8192 next build",
        "start": "pnpm dlx serve out",
        "deploy": "wrangler deploy",
        "postinstall": "fumadocs-mdx",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' source.config.ts --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' source.config.ts --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md,css}' 'content/**/*.mdx' source.config.ts --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md,css}' 'content/**/*.mdx' source.config.ts --cache",
        "tc": "fumadocs-mdx && tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev"
    },
    "dependencies": {
        "@seedcord/docs-engine": "workspace:^",
        "@seedcord/ui": "workspace:^",
        "@shikijs/twoslash": "^4.4.3",
        "fumadocs-core": "16.14.4",
        "fumadocs-mdx": "15.2.3",
        "lucide-react": "catalog:deps",
        "motion": "catalog:deps",
        "next": "catalog:deps",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "shiki": "catalog:deps",
        "twoslash": "^0.3.9",
        "twoslash-protocol": "0.3.9"
    },
    "devDependencies": {
        "@mdx-js/mdx": "^3.1.1",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/gateway": "workspace:^",
        "@seedcord/http": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@tailwindcss/postcss": "catalog:deps",
        "@testing-library/dom": "catalog:test",
        "@testing-library/jest-dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@testing-library/user-event": "catalog:test",
        "@types/mdx": "^2.0.14",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "eslint": "^9.39.4",
        "eslint-config-next": "catalog:eslint",
        "eslint-plugin-better-tailwindcss": "catalog:eslint",
        "eslint-plugin-react-compiler": "catalog:eslint",
        "eslint-plugin-tailwind-canonical-classes": "catalog:eslint",
        "jsdom": "catalog:test",
        "prettier": "catalog:deps",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "tailwindcss": "catalog:deps",
        "typescript": "catalog:peer",
        "vitest": "catalog:test",
        "wrangler": "catalog:deps"
    }
}
