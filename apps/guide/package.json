{
    "name": "@seedcord/guide",
    "version": "0.0.3",
    "type": "module",
    "engines": {
        "node": "^24.22.1 || >=26.12.1"
    },
    "private": true,
    "scripts": {
        "dev": "cross-env TWOSLASH=0 next dev",
        "dev:twoslash": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev",
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build && node -e \"require('node:fs').copyFileSync('_headers', 'dist/_headers')\"",
        "start": "pnpm dlx serve dist",
        "preview": "wrangler dev",
        "deploy": "wrangler deploy",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "prettier --write '**/*.{ts,tsx,json,md,css}' 'content/**/*.mdx' --cache --no-error-on-unmatched-pattern",
        "fmt:check": "prettier --check '**/*.{ts,tsx,json,md,css}' 'content/**/*.mdx' --cache --no-error-on-unmatched-pattern",
        "tc": "fumadocs-mdx && tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev"
    },
    "dependencies": {
        "@seedcord/docs-engine": "workspace:^",
        "@seedcord/docs-search": "workspace:^",
        "@seedcord/ui": "workspace:^",
        "@shikijs/twoslash": "^4.5.0",
        "discord-component-embed": "workspace:^",
        "fumadocs-core": "catalog:deps",
        "fumadocs-mdx": "catalog:deps",
        "lucide-react": "catalog:deps",
        "motion": "catalog:deps",
        "next": "catalog:deps",
        "prettier": "catalog:deps",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "takumi-js": "catalog:deps",
        "twoslash": "0.3.9",
        "twoslash-protocol": "0.3.9"
    },
    "devDependencies": {
        "@discordjs/builders": "catalog:deps",
        "@keyv/sqlite": "6.1.0",
        "@mdx-js/mdx": "catalog:deps",
        "@seedcord/core": "workspace:^",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/gateway": "workspace:^",
        "@seedcord/http": "workspace:^",
        "@seedcord/plugin-kysely-postgres": "workspace:^",
        "@seedcord/plugin-mongoose": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@tailwindcss/postcss": "catalog:deps",
        "@testing-library/dom": "catalog:test",
        "@testing-library/jest-dom": "catalog:test",
        "@testing-library/react": "catalog:test",
        "@testing-library/user-event": "catalog:test",
        "@types/hast": "catalog:deps",
        "@types/mdast": "catalog:deps",
        "@types/mdx": "catalog:deps",
        "@types/pg": "catalog:deps",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "cross-env": "catalog:deps",
        "db0": "catalog:deps",
        "discord-api-types": "catalog:deps",
        "discord.js": "catalog:peer",
        "envapt": "catalog:peer",
        "eslint": "^9.39.4",
        "eslint-config-next": "catalog:eslint",
        "eslint-plugin-better-tailwindcss": "catalog:eslint",
        "eslint-plugin-tailwind-canonical-classes": "catalog:eslint",
        "jsdom": "catalog:test",
        "keyv": "catalog:deps",
        "kysely": "catalog:peer",
        "mdast-util-mdx": "^3.0.0",
        "mdast-util-to-markdown": "catalog:deps",
        "mongoose": "catalog:peer",
        "pg": "catalog:peer",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "remark-mdx": "^3.1.1",
        "remark-parse": "^11.0.0",
        "seedcord": "workspace:^",
        "tailwindcss": "catalog:deps",
        "typescript": "catalog:peer",
        "unified": "^11.0.5",
        "unstorage": "catalog:deps",
        "vfile": "catalog:deps",
        "vitest": "catalog:test",
        "wrangler": "catalog:peer"
    }
}
