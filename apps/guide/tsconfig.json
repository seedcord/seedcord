{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/base",
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "jsx": "preserve",
        "rootDir": ".",
        "plugins": [
            {
                "name": "next"
            }
        ],
        "paths": {
            "#src/*": ["./src/*"],
            "#components/*": ["./src/components/*"],
            "#lib/*": ["./src/lib/*"],
            "#styles/*": ["./src/app/*"]
        },
        "incremental": true,
        "esModuleInterop": true
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/app/.well-known/**/*.ts",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "eslint.config.ts",
        "prettier.config.ts",
        "next.config.ts",
        "vitest.config.ts",
        "source.config.ts",
        ".next/types/**/*.ts",
        "worker.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
