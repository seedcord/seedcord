{
    "name": "discord-component-embed",
    "type": "module",
    "version": "0.1.0",
    "description": "Build Discord component embed link previews with JSX, in any framework.",
    "keywords": [
        "discord",
        "link-preview",
        "component-embed",
        "components-v2",
        "cv2",
        "open-graph",
        "unfurl",
        "react",
        "preact",
        "vue",
        "svelte",
        "solid",
        "solidjs",
        "astro",
        "jsx"
    ],
    "engines": {
        "node": ">=24.11"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/discord-component-embed"
    },
    "homepage": "https://github.com/seedcord/seedcord/tree/next/packages/discord-component-embed#readme",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./react": {
            "import": {
                "types": "./dist/react.index.d.mts",
                "default": "./dist/react.index.mjs"
            }
        },
        "./jsx-runtime": {
            "import": {
                "types": "./dist/jsx-runtime.d.mts",
                "default": "./dist/jsx-runtime.mjs"
            }
        },
        "./jsx-dev-runtime": {
            "import": {
                "types": "./dist/jsx-dev-runtime.d.mts",
                "default": "./dist/jsx-dev-runtime.mjs"
            }
        }
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "prettier --write '**/*.{ts,tsx,json,md}' --cache --no-error-on-unmatched-pattern",
        "fmt:check": "prettier --check '**/*.{ts,tsx,json,md}' --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "preact": "^10.29.8",
        "react": "catalog:react",
        "react-dom": "catalog:react"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "dependencies": {
        "discord-api-types": "catalog:deps"
    }
}
