{
    "name": "discord-component-embed",
    "version": "1.1.0",
    "description": "Build and check Discord component embed link previews, with JSX or plain functions, in any framework.",
    "keywords": [
        "astro",
        "cli",
        "component-embed",
        "components-v2",
        "cv2",
        "discord",
        "discord-embed",
        "discord-link-preview",
        "jsx",
        "link-preview",
        "link-previews",
        "open-graph",
        "preact",
        "react",
        "solid",
        "solidjs",
        "svelte",
        "unfurl",
        "validator",
        "vue"
    ],
    "homepage": "https://github.com/seedcord/seedcord/tree/next/packages/discord-component-embed#readme",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/discord-component-embed"
    },
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "bin": {
        "discord-component-embed": "./dist/cli.mjs"
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": false,
    "types": "./dist/index.d.mts",
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./react": {
            "import": {
                "types": "./dist/react.index.d.mts",
                "default": "./dist/react.index.mjs"
            }
        },
        "./jsx-runtime": {
            "import": {
                "types": "./dist/jsx-runtime.d.mts",
                "default": "./dist/jsx-runtime.mjs"
            }
        },
        "./jsx-dev-runtime": {
            "import": {
                "types": "./dist/jsx-dev-runtime.d.mts",
                "default": "./dist/jsx-dev-runtime.mjs"
            }
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "discord-api-types": "catalog:deps",
        "preact": "^11.0.0",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
