{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/base",
    "compilerOptions": {
        "lib": ["ESNext", "DOM"],
        "types": [],
        "jsx": "react-jsx",
        "rootDir": "./",
        "outDir": "./dist",
        "paths": {
            "#src/*": ["./src/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "eslint.config.ts",
        "tsdown.config.ts",
        "vitest.config.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
