{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "paths": {
            "@src/*": ["./src/*"],
            "@bot/*": ["./src/bot/*"],
            "@subscribers/*": ["./src/subscribers/*"],
            "@hmr/*": ["./src/hmr/*"],
            "@interfaces/*": ["./src/interfaces/*"],
            "@customId/*": ["./src/customId/*"],
            "@miscellaneous/*": ["./src/miscellaneous/*"],

            // Paths inside src/bot
            "@bErrors/*": ["./src/bot/defaults/errors/*"],
            "@bUtilities/*": ["./src/bot/utilities/*"],
            "@bControllers/*": ["./src/bot/controllers/*"],
            "@bDecorators/*": ["./src/bot/decorators/*"]
        },
        "types": ["vite/client"]
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "tsup.config.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "dist"]
}
