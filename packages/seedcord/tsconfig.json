{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../tsconfig/node.json",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "paths": {
            "@ui/*": ["./src/ui/*"],
            "@core/*": ["./src/core/*"],
            "@commands/*": ["./src/commands/*"],
            "@utils/*": ["./src/utils/*"],
            "@api/*": ["./src/api/*"]
        },
        "types": ["react"],
        "jsx": "react"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "playground/**/*.ts",
        "playground/**/*.tsx",
        "tsdown.config.ts",
        "vitest.config.ts"
    ],
    "exclude": ["node_modules", "dist"]
}
