{
    "name": "@seedcord/services",
    "type": "module",
    "version": "0.6.0",
    "description": "Services for Seedcord packages",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/services"
    },
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "default": "./dist/index.mjs"
        },
        "./internal": {
            "types": "./dist/internal.index.d.ts",
            "import": "./dist/internal.index.mjs",
            "require": "./dist/internal.index.cjs",
            "default": "./dist/internal.index.mjs"
        }
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "tc": "tsc --noEmit",
        "test": "pnpm run test:unit && pnpm run test:types",
        "test:unit": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage",
        "test:types": "tsd --files \"tests/**/*.test-d.ts\""
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "dependencies": {
        "@seedcord/types": "workspace:*",
        "@seedcord/utils": "workspace:*",
        "chalk": "catalog:deps",
        "discord.js": "catalog:deps",
        "envapt": "catalog:deps",
        "strip-ansi": "^7.1.2",
        "type-fest": "catalog:deps",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@seedcord/tsup-config": "workspace:*"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
