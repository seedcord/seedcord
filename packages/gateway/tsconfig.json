{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "paths": {
            "#src/*": ["./src/*"],
            "#bot/*": ["./src/bot/*"],
            "#subscribers/*": ["./src/subscribers/*"],
            "#interfaces/*": ["./src/interfaces/*"],
            "#handlers/*": ["./src/handlers/*"],
            "#inputs/*": ["./src/inputs/*"],
            "#pagination/*": ["./src/pagination/*"],
            "#miscellaneous/*": ["./src/miscellaneous/*"],

            // Paths inside src/bot
            "#bUtilities/*": ["./src/bot/utilities/*"],
            "#bControllers/*": ["./src/bot/controllers/*"],
            "#bDecorators/*": ["./src/bot/decorators/*"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "tsdown.config.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "dist"]
}
