{
    "name": "@seedcord/gateway",
    "version": "0.10.0",
    "description": "Gateway transport for seedcord bots, using the discord.js client",
    "keywords": [
        "discord",
        "discord-bot",
        "discordjs",
        "framework",
        "gateway",
        "typescript"
    ],
    "homepage": "https://seedcord.org",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/gateway"
    },
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --max-warnings=0 --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@discordjs/rest": "catalog:deps",
        "@seedcord/core": "workspace:^",
        "@seedcord/custom-id": "workspace:^",
        "@seedcord/errors": "workspace:^",
        "@seedcord/event-emitter": "workspace:^",
        "@seedcord/logger": "workspace:^",
        "@seedcord/types": "workspace:^",
        "@seedcord/utils": "workspace:^",
        "reflect-metadata": "catalog:deps",
        "type-fest": "catalog:deps"
    },
    "devDependencies": {
        "@discordjs/builders": "catalog:peer",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "discord.js": "catalog:peer",
        "envapt": "catalog:peer"
    },
    "peerDependencies": {
        "@discordjs/builders": "catalog:peer",
        "discord.js": "catalog:peer",
        "envapt": "catalog:peer",
        "typescript": "catalog:consumerTypes"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
