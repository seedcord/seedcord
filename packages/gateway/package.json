{
    "name": "@seedcord/gateway",
    "type": "module",
    "version": "0.1.2",
    "engines": {
        "node": ">=24.11"
    },
    "description": "A Discord bot framework built on top of Discord.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/gateway"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "discord.js": "catalog:peer",
        "typescript": "catalog:peer"
    },
    "dependencies": {
        "@discordjs/builders": "catalog:deps",
        "@discordjs/rest": "catalog:deps",
        "@seedcord/core": "workspace:*",
        "@seedcord/errors": "workspace:*",
        "@seedcord/event-emitter": "workspace:*",
        "@seedcord/logger": "workspace:*",
        "@seedcord/rate-limiter": "workspace:*",
        "@seedcord/types": "workspace:*",
        "@seedcord/utils": "workspace:*",
        "chalk": "catalog:deps",
        "envapt": "catalog:deps",
        "reflect-metadata": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@seedcord/tsdown-config": "workspace:*",
        "@seedcord/vitest-config": "workspace:*",
        "discord.js": "catalog:peer",
        "type-fest": "catalog:deps"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "keywords": [
        "discord",
        "discord-bot",
        "discord.js",
        "bot-framework",
        "typescript",
        "seedcord",
        "framework",
        "discord-bot-framework",
        "plugin-system",
        "modular-bot",
        "decorators",
        "commands",
        "discord-api",
        "typescript-framework",
        "event-handler",
        "bot-development",
        "slash-commands",
        "middleware",
        "open-source"
    ]
}
