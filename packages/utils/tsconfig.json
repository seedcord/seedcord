{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "paths": {
            "#src/*": ["./src/*"],
            "#tests/*": ["./tests/*"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "eslint.config.ts", "vite.config.ts"],
    "exclude": ["node_modules", "dist"]
}
