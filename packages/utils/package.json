{
    "name": "@seedcord/utils",
    "version": "0.8.17",
    "description": "Type helpers and small functions used across seedcord",
    "keywords": [
        "discord-bot",
        "seedcord",
        "typescript",
        "utilities"
    ],
    "homepage": "https://seedcord.org",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/utils"
    },
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "imports": {
        "#src/*": "./src/*"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./internal": {
            "import": {
                "types": "./dist/internal.index.d.mts",
                "default": "./dist/internal.index.mjs"
            }
        },
        "./node": {
            "import": {
                "types": "./dist/node.d.mts",
                "default": "./dist/node.mjs"
            }
        },
        "./node/internal": {
            "import": {
                "types": "./dist/node-internal.index.d.mts",
                "default": "./dist/node-internal.index.mjs"
            }
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "vp fmt --write '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "fmt:check": "vp fmt --check '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@seedcord/errors": "workspace:^",
        "@seedcord/types": "workspace:^",
        "discord-api-types": "catalog:deps",
        "strip-ansi": "^7.2.0"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "discord.js": "catalog:peer",
        "tsx": "catalog:deps",
        "type-fest": "catalog:deps",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "typescript": "catalog:consumerTypes"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": ">=24.11"
    }
}
