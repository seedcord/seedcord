{
    "name": "@seedcord/core",
    "version": "0.11.0",
    "description": "Foundational code shared by both transports",
    "keywords": [
        "discord",
        "discord-bot",
        "framework",
        "seedcord",
        "typescript"
    ],
    "homepage": "https://seedcord.org",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/core"
    },
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "imports": {
        "#tests/*": "./tests/*.ts",
        "#src/*": "./src/*.ts",
        "#components/*": "./src/components/*.ts",
        "#customId/*": "./src/customId/*.ts",
        "#decorators/*": "./src/decorators/*.ts",
        "#gates/*": "./src/gates/*.ts",
        "#hmr/*": "./src/hmr/*.ts",
        "#inputs/*": "./src/inputs/*.ts",
        "#interfaces/*": "./src/interfaces/*.ts",
        "#node/*": "./src/node/*.ts",
        "#notices/*": "./src/notices/*.ts",
        "#pagination/*": "./src/pagination/*.ts",
        "#registries/*": "./src/registries/*.ts",
        "#reply/*": "./src/reply/*.ts",
        "#stops/*": "./src/stops/*.ts",
        "#subscribers/*": "./src/subscribers/*.ts"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./plugin": {
            "import": {
                "types": "./dist/plugin.index.d.mts",
                "default": "./dist/plugin.index.mjs"
            }
        },
        "./internal": {
            "import": {
                "types": "./dist/internal.index.d.mts",
                "default": "./dist/internal.index.mjs"
            }
        },
        "./internal/env": {
            "import": {
                "types": "./dist/env-internal.index.d.mts",
                "default": "./dist/env-internal.index.mjs"
            }
        },
        "./node": {
            "import": {
                "types": "./dist/node.index.d.mts",
                "default": "./dist/node.index.mjs"
            }
        },
        "./hmr": {
            "import": {
                "types": "./dist/hmr.index.d.mts",
                "default": "./dist/hmr.index.mjs"
            }
        },
        "./node/internal": {
            "import": {
                "types": "./dist/node-internal.index.d.mts",
                "default": "./dist/node-internal.index.mjs"
            }
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@discordjs/builders": "catalog:deps",
        "@discordjs/rest": "catalog:deps",
        "@seedcord/custom-id": "workspace:^",
        "@seedcord/errors": "workspace:^",
        "@seedcord/event-emitter": "workspace:^",
        "@seedcord/logger": "workspace:^",
        "@seedcord/types": "workspace:^",
        "@seedcord/utils": "workspace:^",
        "discord-api-types": "catalog:deps",
        "reflect-metadata": "catalog:deps",
        "type-fest": "catalog:deps",
        "verkit": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/rate-limiter": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "envapt": "catalog:peer",
        "vite": "catalog:deps",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "envapt": "catalog:peer",
        "typescript": "catalog:consumerTypes"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
