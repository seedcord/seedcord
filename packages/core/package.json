{
    "name": "@seedcord/core",
    "type": "module",
    "version": "0.1.0",
    "engines": {
        "node": ">=24.3"
    },
    "description": "Transport-agnostic core for Seedcord bots",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/core"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./plugin": {
            "import": {
                "types": "./dist/plugin.index.d.mts",
                "default": "./dist/plugin.index.mjs"
            },
            "require": {
                "types": "./dist/plugin.index.d.cts",
                "default": "./dist/plugin.index.cjs"
            }
        },
        "./internal": {
            "import": {
                "types": "./dist/internal.index.d.mts",
                "default": "./dist/internal.index.mjs"
            },
            "require": {
                "types": "./dist/internal.index.d.cts",
                "default": "./dist/internal.index.cjs"
            }
        },
        "./hmr": {
            "import": {
                "types": "./dist/hmr.index.d.mts",
                "default": "./dist/hmr.index.mjs"
            },
            "require": {
                "types": "./dist/hmr.index.d.cts",
                "default": "./dist/hmr.index.cjs"
            }
        },
        "./node/internal": {
            "import": {
                "types": "./dist/node-internal.index.d.mts",
                "default": "./dist/node-internal.index.mjs"
            },
            "require": {
                "types": "./dist/node-internal.index.d.cts",
                "default": "./dist/node-internal.index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "reflect-metadata": "catalog:peer",
        "typescript": "catalog:peer"
    },
    "dependencies": {
        "@discordjs/builders": "catalog:deps",
        "@discordjs/rest": "catalog:deps",
        "@seedcord/errors": "workspace:*",
        "@seedcord/event-emitter": "workspace:*",
        "@seedcord/logger": "workspace:*",
        "@seedcord/types": "workspace:*",
        "@seedcord/utils": "workspace:*",
        "chalk": "catalog:deps",
        "discord-api-types": "catalog:deps",
        "envapt": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/rate-limiter": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@seedcord/tsdown-config": "workspace:*",
        "@seedcord/vitest-config": "workspace:*",
        "reflect-metadata": "catalog:peer",
        "type-fest": "catalog:deps",
        "vite": "catalog:deps"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
