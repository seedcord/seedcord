{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "paths": {
            "#src/*": ["./src/*"],
            "#components/*": ["./src/components/*"],
            "#customId/*": ["./src/customId/*"],
            "#decorators/*": ["./src/decorators/*"],
            "#gates/*": ["./src/gates/*"],
            "#hmr/*": ["./src/hmr/*"],
            "#inputs/*": ["./src/inputs/*"],
            "#interfaces/*": ["./src/interfaces/*"],
            "#node/*": ["./src/node/*"],
            "#notices/*": ["./src/notices/*"],
            "#pagination/*": ["./src/pagination/*"],
            "#registries/*": ["./src/registries/*"],
            "#reply/*": ["./src/reply/*"],
            "#stops/*": ["./src/stops/*"],
            "#subscribers/*": ["./src/subscribers/*"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "eslint.config.ts", "tsdown.config.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "dist"]
}
