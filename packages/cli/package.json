{
    "name": "@seedcord/cli",
    "type": "module",
    "version": "0.0.1",
    "description": "CLI for seedcord",
    "bin": {
        "seedcord": "./bin/seedcord.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/materwelonDhruv/seedcord.git",
        "directory": "packages/cli"
    },
    "files": [
        "bin",
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "scripts": {
        "dev": "tsx src/cli.ts",
        "build": "tsup",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "tc": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "dependencies": {
        "@commander-js/extra-typings": "^14.0.0",
        "@seedcord/services": "workspace:*",
        "@seedcord/types": "workspace:*",
        "@seedcord/utils": "workspace:*",
        "chalk": "catalog:deps",
        "commander": "^14.0.2",
        "fix-esm-import-path": "^1.10.3",
        "ink": "^6.6.0",
        "ink-spinner": "^5.0.0",
        "jiti": "^2.6.1",
        "react": "^19.2.3",
        "tsup": "catalog:peer",
        "tsx": "^4.21.0",
        "vite": "catalog:deps"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@seedcord/tsup-config": "workspace:*",
        "@types/react": "^19.2.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "typescript": "catalog:peer"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
