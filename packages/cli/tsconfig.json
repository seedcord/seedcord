{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "../tsconfig/node.json",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "commander": ["./node_modules/@commander-js/extra-typings"],
            "@ui/*": ["./src/ui/*"]
        },
        "types": ["react", "vite/client"],
        "jsx": "react-jsx"
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "tsup.config.ts"],
    "exclude": ["node_modules", "dist"]
}
