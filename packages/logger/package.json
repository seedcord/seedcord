{
    "name": "@seedcord/logger",
    "type": "module",
    "version": "0.1.0-next.3",
    "engines": {
        "node": ">=24.3"
    },
    "description": "Logging core and winston node sink for Seedcord bots",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/logger"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./node": {
            "import": {
                "types": "./dist/node.d.mts",
                "default": "./dist/node.mjs"
            },
            "require": {
                "types": "./dist/node.d.cts",
                "default": "./dist/node.cjs"
            }
        }
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "dependencies": {
        "@seedcord/types": "workspace:*",
        "@seedcord/utils": "workspace:*",
        "chalk": "catalog:deps",
        "envapt": "catalog:deps",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@seedcord/tsdown-config": "workspace:*",
        "@seedcord/vitest-config": "workspace:*"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
