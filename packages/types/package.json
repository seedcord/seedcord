{
    "name": "@seedcord/types",
    "type": "module",
    "version": "0.14.1",
    "engines": {
        "node": ">=24.11"
    },
    "description": "Config shapes and shared types for seedcord bots",
    "keywords": [
        "discord-bot",
        "seedcord",
        "types",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/types"
    },
    "homepage": "https://seedcord.org",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        },
        "./internal": {
            "import": {
                "types": "./dist/internal.index.d.mts",
                "default": "./dist/internal.index.mjs"
            }
        }
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "prettier --write '**/*.{ts,tsx,json,md}' --cache --no-error-on-unmatched-pattern",
        "fmt:check": "prettier --check '**/*.{ts,tsx,json,md}' --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "discord-api-types": "catalog:deps"
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "discord.js": "catalog:peer",
        "type-fest": "catalog:deps"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
