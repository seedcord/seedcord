{
    "name": "@seedcord/docs-generator",
    "version": "0.2.2",
    "private": true,
    "description": "Internal tooling to generate seedcord API model JSON files",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/docs-generator"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "typesVersions": {
        "*": {
            "*": [
                "./dist/index.d.ts",
                "./src/index.ts"
            ]
        }
    },
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "tc": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "files": [
        "dist",
        "src",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "typedoc": "catalog:docs",
        "typedoc-plugin-dt-links": "catalog:docs",
        "typedoc-plugin-mdn-links": "catalog:docs"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@seedcord/tsdown-config": "workspace:*"
    }
}
