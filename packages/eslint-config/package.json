{
    "name": "@seedcord/eslint-config",
    "type": "module",
    "version": "1.5.0-next.0",
    "description": "ESlint config for Seedcord projects",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/eslint-config"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./prettier": {
            "import": {
                "types": "./dist/prettier.d.mts",
                "default": "./dist/prettier.mjs"
            },
            "require": {
                "types": "./dist/prettier.d.cts",
                "default": "./dist/prettier.cjs"
            }
        }
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint '*.{mjs,ts}' --cache",
        "lint:fix": "eslint '*.{mjs,ts}' --fix --cache",
        "fmt": "prettier --write '*.{mjs,ts,json,md}' --cache",
        "fmt:check": "prettier --check '*.{mjs,ts,json,md}' --cache",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "eslint": "^9.39.4 || ^10.6.0",
        "prettier-plugin-tailwindcss": "catalog:deps",
        "tailwindcss": "catalog:deps",
        "typescript": "catalog:peer"
    },
    "peerDependenciesMeta": {
        "prettier-plugin-tailwindcss": {
            "optional": true
        },
        "tailwindcss": {
            "optional": true
        }
    },
    "dependencies": {
        "@types/eslint-plugin-security": "^3.0.1",
        "@typescript-eslint/parser": "^8.61.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-better-tailwindcss": "^4.6.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-mdx": "^3.8.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-security": "^4.0.1",
        "eslint-plugin-tailwind-canonical-classes": "^1.3.3",
        "eslint-plugin-tsdoc": "^0.5.2",
        "eslint-plugin-unicorn": "^70.0.0",
        "lodash.merge": "^4.6.2",
        "prettier": "catalog:deps",
        "typescript-eslint": "^8.61.1"
    },
    "devDependencies": {
        "@types/lodash.merge": "^4.6.9",
        "eslint": "catalog:deps"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
