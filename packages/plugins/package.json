{
    "name": "@seedcord/plugins",
    "type": "module",
    "version": "0.8.0-next.8",
    "engines": {
        "node": ">=24.3"
    },
    "description": "Official plugins for Seedcord Discord bot framework",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/plugins"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "kysely": "^0.29.2",
        "mongoose": "catalog:peer",
        "pg": "^8.21.0",
        "reflect-metadata": "catalog:peer",
        "typescript": "catalog:peer"
    },
    "peerDependenciesMeta": {
        "kysely": {
            "optional": true
        },
        "mongoose": {
            "optional": true
        },
        "pg": {
            "optional": true
        }
    },
    "dependencies": {
        "@seedcord/core": "workspace:*",
        "@seedcord/errors": "workspace:*",
        "@seedcord/logger": "workspace:*",
        "@seedcord/types": "workspace:*",
        "@seedcord/utils": "workspace:*",
        "chalk": "catalog:deps",
        "envapt": "catalog:deps",
        "@seedcord/gateway": "workspace:*"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@seedcord/tsdown-config": "workspace:*",
        "@seedcord/vitest-config": "workspace:*",
        "@types/pg": "^8.20.0",
        "kysely": "^0.29.2",
        "mongoose": "catalog:peer",
        "pg": "^8.21.0",
        "reflect-metadata": "catalog:peer",
        "type-fest": "catalog:deps"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
