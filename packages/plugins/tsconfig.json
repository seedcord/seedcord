{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "paths": {
            "@src/*": ["./src/*"],
            "@shared/*": ["./src/shared*"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "tsup.config.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "dist"]
}
