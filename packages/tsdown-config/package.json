{
    "name": "@seedcord/tsdown-config",
    "type": "module",
    "version": "2.0.0",
    "private": true,
    "description": "Internal tsdown preset for seedcord packages",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.mts",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "packages/tsdown-config"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsdown --config-loader tsx",
        "clean": "rm -rf dist",
        "lint": "eslint '*.{mjs,ts}' --cache",
        "lint:fix": "eslint '*.{mjs,ts}' --fix --cache",
        "fmt": "prettier --write '*.{mjs,ts,json,md}' --cache",
        "fmt:check": "prettier --check '*.{mjs,ts,json,md}' --cache",
        "tc": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "dependencies": {
        "tsdown": "catalog:peer"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@types/node": "catalog:deps",
        "typescript": "catalog:peer"
    }
}
