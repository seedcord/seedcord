{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "ignoreBinaries": ["seedcord", "continue"],
    "ignoreWorkspaces": ["mock"],
    "rules": {
        "optionalPeerDependencies": "off"
    },
    "workspaces": {
        ".": {
            "entry": ["scripts/**/*.ts", "turbo/generators/**/*.ts"],
            "project": ["scripts/**/*.ts", "turbo/generators/**/*.ts"]
        },
        "packages/seedcord": {},
        "packages/services": {},
        "packages/utils": {},
        "packages/types": {},
        "packages/plugins": {},
        "packages/errors": {},
        "packages/kit": {},
        "packages/cli": {
            "ignoreDependencies": ["fix-esm-import-path", "@seedcord/tsconfig"]
        },
        "packages/docs-engine": {},
        "packages/docs-generator": {
            "ignore": ["tests/mock/**"]
        },
        "packages/eslint-config": {
            "ignoreDependencies": ["@typescript-eslint/eslint-plugin", "@typescript-eslint/parser"]
        },
        "packages/tsdown-config": {},
        "packages/tsconfig": {},
        "apps/docs": {
            "entry": ["src/app/**/{page,layout,route,not-found}.{ts,tsx}"],
            "project": ["src/**/*.{ts,tsx}"]
        },
        "apps/home": {
            "entry": ["src/app/**/{page,layout,route,not-found}.{ts,tsx}"],
            "project": ["src/**/*.{ts,tsx}"]
        }
    }
}
