{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "ignoreBinaries": [
        "seedcord"
    ],
    "ignoreDependencies": [
        "fallow"
    ],
    "ignoreWorkspaces": [
        "mocks/*"
    ],
    "rules": {
        "optionalPeerDependencies": "off"
    },
    "workspaces": {
        ".": {
            "entry": [
                "scripts/**/*.ts",
                "turbo/generators/**/*.ts"
            ],
            "project": [
                "scripts/**/*.ts",
                "turbo/generators/**/*.ts"
            ]
        },
        "apps/docs": {
            "entry": [
                "src/app/**/{page,layout,route,not-found}.{ts,tsx}"
            ],
            "project": [
                "src/**/*.{ts,tsx,css}"
            ]
        },
        "apps/guide": {
            "entry": [
                "src/app/**/{page,layout,route,not-found}.{ts,tsx}"
            ],
            "project": [
                "src/**/*.{ts,tsx,css}"
            ]
        },
        "apps/home": {
            "entry": [
                "src/app/**/{page,layout,route,not-found}.{ts,tsx}"
            ],
            "project": [
                "src/**/*.{ts,tsx,css}"
            ]
        },
        "packages/core": {
            "entry": [
                "**/*.types-test.ts"
            ]
        },
        "packages/errors": {
            "entry": [
                "**/*.types-test.ts"
            ]
        },
        "tooling/eslint-plugin": {
            "ignore": [
                "tests/fixtures/**"
            ],
            "ignoreDependencies": [
                "discord.js"
            ]
        },
        "tooling/eslint-plugin-discordjs": {
            "ignore": [
                "tests/fixtures/**"
            ],
            "ignoreDependencies": [
                "discord.js"
            ]
        },
        "tooling/eslint-utils": {},
        "packages/event-emitter": {},
        "packages/gateway": {
            "entry": [
                "**/*.types-test.ts"
            ]
        },
        "packages/http": {
            "ignore": [
                "tests/node/commands/fixtures/**",
                "tests/node/discovery/fixtures/**",
                "tests/node/discovery/duplicates/**"
            ],
            "entry": [
                "**/*.types-test.ts"
            ]
        },
        "packages/logger": {
            "entry": [
                "**/*.types-test.ts"
            ]
        },
        "packages/rate-limiter": {},
        "packages/types": {
            "entry": [
                "**/*.types-test.ts"
            ]
        },
        "packages/utils": {
            "ignore": [
                "tests/node/fixtures/**"
            ]
        },
        "plugins/kysely-postgres": {
            "entry": [
                "**/*.types-test.ts"
            ]
        },
        "plugins/mongoose": {
            "entry": [
                "**/*.types-test.ts"
            ]
        },
        "cli/seedcord": {
            "ignoreDependencies": [
                "tsc-alias"
            ]
        },
        "cli/create-seedcord": {
            "entry": [
                "**/*.types-test.ts"
            ]
        },
        "tooling/docs-engine": {},
        "tooling/docs-generator": {
            "ignore": [
                "tests/mock/**"
            ]
        },
        "tooling/eslint-config": {
            "ignoreDependencies": [
                "@types/eslint-plugin-security",
                "@typescript-eslint/parser",
                "eslint-config-prettier",
                "eslint-plugin-prettier",
                "eslint-plugin-security",
                "eslint-plugin-tsdoc",
                "eslint-plugin-unicorn",
                "lodash.merge"
            ]
        },
        "tooling/eslint-config-base": {
            "ignoreDependencies": [
                "@typescript-eslint/parser"
            ]
        },
        "tooling/tsconfig": {},
        "tooling/tsdown-config": {},
        "tooling/ui": {},
        "tooling/vitest-config": {}
    }
}
