{
    "$schema": "https://unpkg.com/knip@latest/schema.json",
    "ignoreBinaries": [
        "seedcord",
        "continue"
    ],
    "ignoreWorkspaces": [
        "mock"
    ],
    "rules": {
        "optionalPeerDependencies": "off"
    },
    "workspaces": {
        ".": {
            "entry": [
                "scripts/**/*.ts",
                "turbo/generators/**/*.ts"
            ],
            "project": [
                "scripts/**/*.ts",
                "turbo/generators/**/*.ts"
            ]
        },
        "apps/docs": {
            "entry": [
                "src/app/**/{page,layout,route,not-found}.{ts,tsx}"
            ],
            "project": [
                "src/**/*.{ts,tsx}"
            ]
        },
        "apps/home": {
            "entry": [
                "src/app/**/{page,layout,route,not-found}.{ts,tsx}"
            ],
            "project": [
                "src/**/*.{ts,tsx}"
            ]
        },
        "packages/seedcord": {
            "ignoreDependencies": [
                "fix-esm-import-path",
                "@seedcord/tsconfig"
            ]
        },
        "packages/core": {},
        "packages/docs-engine": {},
        "packages/docs-generator": {
            "ignore": [
                "tests/mock/**"
            ]
        },
        "packages/errors": {},
        "packages/eslint-config": {
            "ignoreDependencies": [
                "@types/eslint-plugin-security",
                "@typescript-eslint/parser",
                "eslint-config-prettier",
                "eslint-plugin-better-tailwindcss",
                "eslint-plugin-mdx",
                "eslint-plugin-prettier",
                "eslint-plugin-security",
                "eslint-plugin-tailwind-canonical-classes",
                "eslint-plugin-tsdoc",
                "eslint-plugin-unicorn",
                "lodash.merge"
            ]
        },
        "packages/eslint-config-base": {
            "ignoreDependencies": [
                "@typescript-eslint/parser"
            ]
        },
        "packages/eslint-plugin": {
            "ignore": [
                "tests/fixtures/**"
            ],
            "ignoreDependencies": [
                "discord.js"
            ]
        },
        "packages/eslint-plugin-discordjs": {
            "ignore": [
                "tests/fixtures/**"
            ],
            "ignoreDependencies": [
                "discord.js"
            ]
        },
        "packages/eslint-utils": {},
        "packages/plugins": {},
        "packages/rate-limiter": {},
        "packages/event-emitter": {},
        "packages/logger": {},
        "packages/gateway": {},
        "packages/http": {
            "ignore": [
                "tests/node/discovery/fixtures/**"
            ]
        },
        "packages/tsconfig": {},
        "packages/tsdown-config": {},
        "packages/types": {},
        "packages/utils": {}
    }
}
