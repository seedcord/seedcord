{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "types": ["node", "vite/client"],
{{#if isEdge}}
        "customConditions": ["workerd"],
{{/if}}
        "paths": {
            "#src/*": ["./src/*"],
            "#components/*": ["./src/components/*"],
            "#plugins/*": ["./src/plugins/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "eslint.config.ts",
        "prettier.config.ts",
        "seedcord.config.ts"{{#if isEdge}},
        "cloudflare.config.ts",
        ".cloudflare/types/index.d.ts"{{/if}}
    ],
    "exclude": ["node_modules", "dist"]
}
