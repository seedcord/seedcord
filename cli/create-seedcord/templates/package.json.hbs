{
    "name": "{{ projectName }}",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "engines": {
        {{#if pm.isBun}}"bun": "{{ engines.bun }}"{{else}}"node": "{{ engines.node }}"{{/if}}
    },
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "start": "node --enable-source-maps dist/index.mjs",
        "codegen": "seedcord codegen",
        "lint": "eslint 'src/**/*.ts' --cache",
        "lint:fix": "eslint 'src/**/*.ts' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,json,md}' --cache",
        "tc": "tsc --noEmit"
    }
}
