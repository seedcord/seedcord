{
    "name": "create-seedcord",
    "type": "module",
    "version": "0.0.1",
    "description": "Scaffold a new seedcord bot project",
    "engines": {
        "node": ">=24.11"
    },
    "bin": {
        "create-seedcord": "./bin/create-seedcord.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "cli/create-seedcord"
    },
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "bin",
        "dist",
        "templates",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' --cache",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@seedcord/tsdown-config": "workspace:*",
        "@seedcord/types": "workspace:*",
        "@seedcord/vitest-config": "workspace:*",
        "discord.js": "catalog:peer",
        "tsx": "catalog:deps",
        "typescript": "catalog:peer"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
