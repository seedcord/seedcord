{
    "name": "create-seedcord",
    "version": "0.4.2",
    "description": "Scaffold a new seedcord bot",
    "keywords": [
        "create",
        "discord",
        "discord-bot",
        "scaffold",
        "seedcord",
        "starter"
    ],
    "homepage": "https://seedcord.org",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "cli/create-seedcord"
    },
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "bin": {
        "create-seedcord": "./bin/create-seedcord.mjs"
    },
    "files": [
        "bin",
        "dist",
        "templates",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "imports": {
        "#package": "./package.json",
        "#cli/*": "./src/cli/*",
        "#interview/*": "./src/interview/*",
        "#scaffold/*": "./src/scaffold/*",
        "#template/*": "./src/template/*",
        "#tests/*": "./tests/*"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' --fix --cache --no-error-on-unmatched-pattern",
        "fmt": "vp fmt --write '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "fmt:check": "vp fmt --check '**/*.{ts,tsx,json,md}' --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "devDependencies": {
        "@seedcord/cli-prompts": "workspace:^",
        "@seedcord/errors": "workspace:^",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/types": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "discord.js": "catalog:peer",
        "handlebars": "^4.7.9",
        "package-manager-detector": "^1.8.0",
        "tsx": "catalog:deps",
        "typescript": "catalog:peer",
        "vitest": "catalog:test"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": ">=24.11"
    },
    "seedcordDocs": {
        "skip": true
    }
}
