{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "@seedcord/tsconfig/node",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "paths": {
            "#cli/*": ["./src/cli/*"],
            "#interview/*": ["./src/interview/*"],
            "#scaffold/*": ["./src/scaffold/*"],
            "#template/*": ["./src/template/*"]
        }
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "eslint.config.ts", "tsdown.config.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "dist"]
}
