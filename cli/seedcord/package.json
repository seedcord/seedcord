{
    "name": "seedcord",
    "version": "0.22.0",
    "description": "The seedcord CLI. Dev server, build, and codegen for a typed Discord bot.",
    "keywords": [
        "cli",
        "codegen",
        "discord",
        "discord-bot",
        "hmr",
        "seedcord"
    ],
    "homepage": "https://seedcord.org",
    "bugs": "https://github.com/seedcord/seedcord/issues",
    "license": "Apache-2.0",
    "author": "Dhruv <materwelondhruv@gmail.com> (https://materwelon.dev)",
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "cli/seedcord"
    },
    "funding": "https://github.com/sponsors/materwelonDhruv",
    "bin": {
        "seedcord": "./bin/seedcord.mjs"
    },
    "files": [
        "bin",
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "types": "./dist/index.d.mts",
    "imports": {
        "#src/*": "./src/*.ts",
        "#tests/*": "./tests/*.ts",
        "#ui/*": "./src/ui/*",
        "#core/*": "./src/core/*.ts",
        "#commands/*": "./src/commands/*.ts",
        "#utils/*": "./src/utils/*.ts",
        "#api/*": "./src/api/*.ts"
    },
    "exports": {
        ".": {
            "workerd": {
                "types": "./dist/workerd.index.d.mts",
                "default": "./dist/workerd.index.mjs"
            },
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            }
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "dev": "vpx src/cli.ts",
        "preview": "vpx playground/preview.tsx",
        "preview:prompts": "vpx playground/prompts.ts",
        "build": "vp pack",
        "clean": "rm -rf dist",
        "lint": "eslint '**/*.{ts,tsx}' 'bin/**/*.mjs' --cache --no-error-on-unmatched-pattern",
        "lint:fix": "eslint '**/*.{ts,tsx}' 'bin/**/*.mjs' --fix --cache --no-error-on-unmatched-pattern",
        "tc": "tsgo --noEmit",
        "test": "vp test run",
        "test:watch": "vp test dev",
        "coverage": "vp test run --coverage"
    },
    "dependencies": {
        "@cloudflare/build-output-utils": "0.9.2",
        "@cloudflare/config": "0.26.0",
        "@commander-js/extra-typings": "^15.0.0",
        "@discordjs/rest": "catalog:deps",
        "@leeoniya/ufuzzy": "catalog:deps",
        "@seedcord/core": "workspace:^",
        "@seedcord/errors": "workspace:^",
        "@seedcord/event-emitter": "workspace:^",
        "@seedcord/logger": "workspace:^",
        "@seedcord/types": "workspace:^",
        "@seedcord/utils": "workspace:^",
        "chalk": "catalog:deps",
        "cli-spinners": "catalog:deps",
        "commander": "^15.0.0",
        "discord-api-types": "catalog:deps",
        "es-toolkit": "catalog:deps",
        "handlebars": "catalog:deps",
        "ink": "catalog:deps",
        "minimatch": "^10.2.6",
        "react": "catalog:react",
        "reflect-metadata": "catalog:deps",
        "rolldown-plugin-dts": "0.28.8",
        "verkit": "catalog:deps",
        "wrap-ansi": "^10.0.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "catalog:peer",
        "@eslint-react/eslint-plugin": "catalog:eslint",
        "@seedcord/cli-prompts": "workspace:^",
        "@seedcord/cli-templates": "workspace:^",
        "@seedcord/eslint-config": "workspace:^",
        "@seedcord/gateway": "workspace:^",
        "@seedcord/http": "workspace:^",
        "@seedcord/tsconfig": "workspace:^",
        "@seedcord/tsdown-config": "workspace:^",
        "@seedcord/vitest-config": "workspace:^",
        "@types/react": "catalog:react",
        "cf": "catalog:deps",
        "discord.js": "catalog:peer",
        "envapt": "catalog:peer",
        "eslint-plugin-react-hooks": "catalog:eslint",
        "ink-testing-library": "^4.0.0",
        "type-fest": "catalog:deps",
        "typescript": "catalog:peer",
        "vite": "catalog:deps",
        "vitest": "catalog:test"
    },
    "peerDependencies": {
        "@cloudflare/vite-plugin": "catalog:peer",
        "envapt": "catalog:peer",
        "typescript": "catalog:consumerTypes",
        "vite": "catalog:peer"
    },
    "peerDependenciesMeta": {
        "@cloudflare/vite-plugin": {
            "optional": true
        }
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": "^24.22.1 || >=26.12.1"
    }
}
