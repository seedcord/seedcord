{
    "name": "seedcord",
    "type": "module",
    "version": "0.17.0",
    "engines": {
        "node": ">=24.11"
    },
    "description": "The seedcord CLI and dev tooling",
    "bin": {
        "seedcord": "./bin/seedcord.mjs"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/seedcord/seedcord.git",
        "directory": "cli/seedcord"
    },
    "files": [
        "bin",
        "dist",
        "package.json",
        "README.md",
        "LICENSE"
    ],
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "dev": "tsx src/cli.ts",
        "preview": "tsx playground/preview.tsx",
        "build": "tsdown",
        "clean": "rm -rf dist",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' 'playground/**/*.{ts,tsx}' --cache",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' 'playground/**/*.{ts,tsx}' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' 'playground/**/*.{ts,tsx}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,tsx,json,md}' 'tests/**/*.{ts,tsx,json,md}' 'playground/**/*.{ts,tsx}' --cache",
        "tc": "tsgo --noEmit",
        "test": "vitest run",
        "test:watch": "vitest dev",
        "coverage": "vitest run --coverage"
    },
    "peerDependencies": {
        "typescript": "catalog:peer"
    },
    "dependencies": {
        "@clack/prompts": "^1.7.0",
        "@commander-js/extra-typings": "^15.0.0",
        "@discordjs/rest": "catalog:deps",
        "@seedcord/core": "workspace:*",
        "@seedcord/errors": "workspace:*",
        "@seedcord/event-emitter": "workspace:*",
        "@seedcord/logger": "workspace:*",
        "@seedcord/types": "workspace:*",
        "@seedcord/utils": "workspace:*",
        "chalk": "catalog:deps",
        "commander": "^15.0.0",
        "discord-api-types": "catalog:deps",
        "envapt": "catalog:deps",
        "fix-esm-import-path": "^1.10.3",
        "ink": "^7.1.1",
        "ink-spinner": "^5.0.0",
        "jiti": "^2.7.0",
        "minimatch": "^10.2.6",
        "react": "catalog:react",
        "tsx": "catalog:deps",
        "vite": "catalog:deps",
        "wrap-ansi": "^10.0.0"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.18.1",
        "@seedcord/eslint-config": "workspace:*",
        "@seedcord/tsconfig": "workspace:*",
        "@seedcord/tsdown-config": "workspace:*",
        "@seedcord/vitest-config": "workspace:*",
        "@types/react": "catalog:react",
        "discord.js": "catalog:peer",
        "eslint-plugin-react-hooks": "^7.1.1",
        "ink-testing-library": "^4.0.0",
        "typescript": "catalog:peer"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
